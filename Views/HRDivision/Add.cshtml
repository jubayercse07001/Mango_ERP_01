@using ERP.Models.HR.Organization.HrDivision;
@{
    ViewBag.Title = "Add Division";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">

                <a href="@Url.Action("Index","Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index","HrDivision")" class="breadcrumb-item">
                    HrDivision
                </a>

                <span class="breadcrumb-item active">Add</span>

            </div>
        </div>
    </div>

</div>

<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Add New Division</h6>
            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">
                        <!-- Company Dropdown -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Company
                            </label>

                            <div class="col-lg-8">
                                <select name="ParentId"
                                        id="ParentId"
                                        class="form-control">
                                    <option value="">
                                        Select Company
                                    </option>

                                    @if (ViewBag.CompanyList != null)
                                    {
                                        foreach (var item in ViewBag.CompanyList)
                                        {
                                            <option value="@item.RowId">
                                                @item.CompanyName
                                            </option>
                                        }
                                    }

                                </select>
                            </div>
                        </div>

                        <!-- Main Division Dropdown -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Main Division
                            </label>

                            <div class="col-lg-8">
                                <select name="MainDivisionId"
                                        id="MainDivisionId"
                                        class="form-control">

                                    <option value="">
                                        Select Main Division
                                    </option>

                                    @if (ViewBag.MainDivisionList != null)
                                    {
                                        foreach (var item in ViewBag.MainDivisionList)
                                        {
                                            <option value="@item.RowId">
                                                @item.MainDivisionName
                                            </option>
                                        }
                                    }

                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Division Name
                            </label>

                            <div class="col-lg-8">
                                <input type="text"
                                       name="DivisionName"
                                       class="form-control"
                                       placeholder="Division Name">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Short Name
                            </label>

                            <div class="col-lg-8">
                                <input type="text"
                                       name="ShortDivisionName"
                                       class="form-control"
                                       placeholder="Short Division Name">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Address
                            </label>

                            <div class="col-lg-8">
                                <textarea name="Address"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Address"></textarea>
                            </div>
                        </div>

                       

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Phone
                            </label>

                            <div class="col-lg-8">
                                <input type="text"
                                       name="Phone"
                                       class="form-control"
                                       placeholder="Phone">
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Mobile
                            </label>

                            <div class="col-lg-8">
                                <input type="text"
                                       name="Mobile"
                                       class="form-control"
                                       placeholder="Mobile">
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Fax
                            </label>

                            <div class="col-lg-8">
                                <input type="text"
                                       name="Fax"
                                       class="form-control"
                                       placeholder="Fax">
                            </div>
                        </div>



                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Rank
                            </label>

                            <div class="col-lg-8">
                                <input type="number"
                                       name="Rank"
                                       class="form-control"
                                       value="0">
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Error Area -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>
                </div>

            </div>

            <!-- Submit -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-12">

                        <div class="d-flex justify-content-between">

                            <button type="button"
                                    id="btnSubmit"
                                    class="btn bg-blue">

                                Submit
                                <i class="icon-paperplane ml-2"></i>

                            </button>

                            <a href="@Url.Action("Index","HrDivision")"
                               class="btn btn-light">

                                Back To List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Success Div -->
        <div class="card"
             id="successdiv"
             style="display:none">

            <div class="card-header bg-white">
                <h6 class="card-title">
                    Division Added Successfully
                </h6>
            </div>

            <div class="card-body">

                <h4 class="text-success">
                    Division information has been added successfully.
                </h4>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <a href="@Url.Action("Add","HrDivision")"
                       class="btn btn-light">

                        Add Another

                    </a>

                    <a href="@Url.Action("Index","HrDivision")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript{

    <script>

$(document).ready(function () {

    $("#btnSubmit").click(function () {

        $.ajax({

            type: "POST",

            url: '@Url.Action("Add", "HrDivision")',

            data: $("#my-form").serialize(),

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout", "Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index", "HrDivision")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(data.ResponseMessage);
                    $("#errordiv").show();

                }
                else {

                    $("#errormessage").html("");
                    $("#errordiv").hide();

                    $("#maindiv").hide();
                    $("#successdiv").show();

                }
            },

            error: function (xhr) {

                $("#errormessage").html(xhr.responseText);
                $("#errordiv").show();

            }

        });

    });

});

    </script>

}