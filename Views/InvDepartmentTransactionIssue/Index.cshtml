@using ERP.Models.Inventory.InvDepartmentRequisition

@{
    ViewBag.Title = "Department Transaction Issue";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ========================================================= -->
<!-- PAGE HEADER                                                -->
<!-- ========================================================= -->

<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i>
                    Home

                </a>

                <span class="breadcrumb-item">
                    Inventory
                </span>

                <span class="breadcrumb-item active">
                    Department Transaction Issue
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">

                <i class="icon-more"></i>

            </a>

        </div>

        <div class="header-elements d-none">

            <div class="breadcrumb justify-content-center">
            </div>

        </div>

    </div>
</div>


<!-- ========================================================= -->
<!-- CONTENT                                                     -->
<!-- ========================================================= -->

<div class="content">

    <div class="card">

        <!-- ===================================================== -->
        <!-- CARD HEADER                                            -->
        <!-- ===================================================== -->

        <div class="card-header header-elements-inline">

            <h5 class="card-title">
                List of Department Transaction Issues
            </h5>

            <div class="header-elements">

                <button type="button"
                        class="btn btn-light mr-3 text-success"
                        onclick="$('#my-form').toggle();">

                    <i class="icon-search4 mr-2"></i>
                    Advance Search

                </button>

                <button type="button"
                        class="btn btn-light text-danger-300"
                        onclick="ResetSearch();">

                    <i class="icon-reset mr-2"></i>
                    Reset Search

                </button>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- SEARCH FORM                                            -->
        <!-- ===================================================== -->

        <form id="my-form"
              style="display:none;">

            <div class="card-body">

                <div class="row">

                    <!-- Requisition Code -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Requisition Code
                            </label>

                            <input type="text"
                                   id="RequisitionCode"
                                   name="RequisitionCode"
                                   class="form-control"
                                   placeholder="Requisition Code" />

                        </div>

                    </div>


                    <!-- Requisition Name -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Requisition Name
                            </label>

                            <input type="text"
                                   id="RequisitionName"
                                   name="RequisitionName"
                                   class="form-control"
                                   placeholder="Requisition Name" />

                        </div>

                    </div>


                    <!-- Department -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Department
                            </label>

                            <select id="DepartmentId"
                                    name="DepartmentId"
                                    class="form-control">

                                <option value="">
                                    -- Select Department --
                                </option>

                                @if (ViewBag.DepartmentList != null)
                                {
                                    foreach (var item
                                        in ViewBag.DepartmentList)
                                    {
                                        <option value="@item.RowId">
                                            @item.DepartmentName
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                    </div>


                    <!-- Job No -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Job No
                            </label>

                            <input type="text"
                                   id="JobNo"
                                   name="JobNo"
                                   class="form-control"
                                   placeholder="Job No" />

                        </div>

                    </div>


                    <!-- From Date -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                From Date
                            </label>

                            <input type="date"
                                   id="FromDate"
                                   name="FromDate"
                                   class="form-control" />

                        </div>

                    </div>


                    <!-- To Date -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                To Date
                            </label>

                            <input type="date"
                                   id="ToDate"
                                   name="ToDate"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

            </div>


            <!-- SEARCH FOOTER -->
            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between align-items-center">

                    <button type="button"
                            class="btn btn-light text-brown-300"
                            onclick="$('#my-form').hide();">

                        Close Search Panel

                    </button>


                    <div>

                        <button type="button"
                                class="btn btn-light text-danger-300 mr-2"
                                onclick="ResetSearch();">

                            <i class="icon-reset mr-2"></i>
                            Reset Search

                        </button>


                        <button type="button"
                                class="btn btn-primary"
                                onclick="ReloadDataTable();">

                            <i class="icon-search4 mr-2"></i>
                            Search

                        </button>

                    </div>

                </div>

            </div>

        </form>


        <!-- ===================================================== -->
        <!-- DATATABLE                                              -->
        <!-- ===================================================== -->

        <table class="table datatable-column-search-inputs"
               id="RequisitionItemList">

            <thead>

                <tr>

                    <th>
                        Requisition ID
                    </th>

                    <th>
                        Date
                    </th>

                    <th>
                        Requisition Code
                    </th>

                    <th>
                        Requested By
                    </th>

                    <th>
                        Department
                    </th>

                    <th>
                        Job No
                    </th>

                    <th class="text-center">
                        Status
                    </th>

                    <th class="text-center">
                        Action
                    </th>

                </tr>

            </thead>

            <tbody>
            </tbody>

        </table>

    </div>

</div>


@section ChildpageJavaScript
{
    <script type="text/javascript">

    var dtTable = null;


    // =============================================================
    // STATUS BADGE
    // =============================================================

    function StatusBadge(status) {

        status = parseInt(status);

        switch (status) {

            case 0:
                return "<span class='badge badge-info'>NEW</span>";

            case 1:
                return "<span class='badge badge-warning'>FORWARDED</span>";

            case 2:
                return "<span class='badge badge-primary'>" +
                       "<i class='icon-checkmark3 mr-1'></i>" +
                       " APPROVED" +
                       "</span>";

            case 3:
                return "<span class='badge badge-danger'>REJECTED</span>";

            case 4:
                return "<span class='badge badge-success'>" +
                       "<i class='icon-checkmark3 mr-1'></i>" +
                       " ISSUED" +
                       "</span>";

            case 5:
                return "<span class='badge badge-secondary'>" +
                       "RECEIVED" +
                       "</span>";

            default:
                return "<span class='badge badge-secondary'>" +
                       "UNKNOWN" +
                       "</span>";
        }
    }


    // =============================================================
    // DATE FORMAT
    // =============================================================

    function FormatDate(value) {

        if (!value)
            return "";

        var date;

        var aspNetMatch =
            /\/Date\((\d+)\)\//.exec(value);

        if (aspNetMatch) {

            date =
                new Date(
                    parseInt(
                        aspNetMatch[1],
                        10));

        }
        else {

            date =
                new Date(value);
        }


        if (isNaN(date.getTime()))
            return value;


        var day =
            ("0" + date.getDate()).slice(-2);

        var month =
            ("0" + (date.getMonth() + 1)).slice(-2);

        var year =
            date.getFullYear();


        return day +
               "-" +
               month +
               "-" +
               year;
    }


    // =============================================================
    // RELOAD DATATABLE
    // =============================================================

    function ReloadDataTable() {

        if (dtTable == null)
            return;


        var searchUrl =
            "@Url.Action(
                "GetInvDepartmentRequisitionItemList",
                "InvDepartmentTransactionIssue")?" +
            $("#my-form").serialize();


        dtTable.ajax
               .url(searchUrl)
               .load();
    }


    // =============================================================
    // RESET SEARCH
    // =============================================================

    function ResetSearch() {

        $("#my-form")[0].reset();

        ReloadDataTable();
    }


    // =============================================================
    // DATATABLE
    // =============================================================

    function UpdateDataTable() {

        dtTable =
            $("#RequisitionItemList").DataTable({

                processing: true,

                serverSide: true,

                searching: true,

                ordering: true,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],


                // -------------------------------------------------
                // AJAX
                // -------------------------------------------------

                ajax: {

                    url:
                        "@Url.Action(
                            "GetInvDepartmentRequisitionItemList",
                            "InvDepartmentTransactionIssue")?" +
                        $("#my-form").serialize(),

                    type: "GET",


                    dataSrc: function (json) {

                        if (json.error) {

                            console.error(
                                "Server Error:",
                                json.error);
                        }


                        return json.data || [];
                    },


                    error: function (
                        xhr,
                        status,
                        error) {

                        console.error(
                            "Department Transaction Issue error:",
                            xhr.status,
                            xhr.responseText);
                    }
                },


                // -------------------------------------------------
                // COLUMNS
                // -------------------------------------------------

                columns: [

                    // Requisition ID
                    {
                        data: "RequisitionId",
                        defaultContent: ""
                    },


                    // Date
                    {
                        data: "RequisitionDate",
                        defaultContent: "",

                        render:
                            function (
                                data,
                                type) {

                                if (type === "display" ||
                                    type === "filter") {

                                    return FormatDate(data);
                                }

                                return data;
                            }
                    },


                    // Requisition Code
                    {
                        data: "RequisitionCode",
                        defaultContent: ""
                    },


                    // Requested By
                    {
                        data: "RequestedByName",
                        defaultContent: "",

                        render:
                            function (
                                data,
                                type,
                                row) {

                                return data ||
                                       row.RequestedBy ||
                                       "";
                            }
                    },


                    // Department
                    {
                        data: "DepartmentName",
                        defaultContent: ""
                    },


                    // Job No
                    {
                        data: "JobNo",
                        defaultContent: ""
                    },


                    // Status
                    {
                        data: "Status",

                        className:
                            "text-center",

                        render:
                            function (
                                data,
                                type) {

                                if (type === "display") {

                                    return StatusBadge(
                                        data);
                                }

                                return data;
                            }
                    },


                    // =================================================
                    // ACTION
                    // ONLY ISSUE
                    // =================================================
                    {
                        data: "RowId",

                        orderable: false,

                        searchable: false,

                        className:
                            "text-center",

                        render:
                            function (
                                data,
                                type,
                                row) {

                                // -------------------------------------
                                // SERVER SIDE ALSO FILTERS THESE.
                                // This is an additional UI safeguard.
                                // -------------------------------------

                                if (
                                    parseInt(row.Status) !== 2 ||
                                    parseInt(row.IsApproved) !== 1 ||
                                    parseInt(row.IsIssued) === 1
                                ) {
                                    return "";
                                }


                                // -------------------------------------
                                // IMPORTANT:
                                //
                                // Use QUERY STRING:
                                //
                                // /Issue?id=xxxxx
                                //
                                // instead of:
                                //
                                // /Issue/xxxxx
                                //
                                // This avoids route configuration
                                // problems.
                                // -------------------------------------

                                var issueUrl =
                                    "@Url.Action(
                                        "Issue",
                                        "InvDepartmentTransactionIssue")" +
                                    "?id=" +
                                    encodeURIComponent(data);


                                return (

                                    "<div class='list-icons'>" +

                                        "<div class='dropdown'>" +

                                            "<a href='#' " +
                                               "class='list-icons-item' " +
                                               "data-toggle='dropdown'>" +

                                                "<i class='icon-menu9'></i>" +

                                            "</a>" +


                                            "<div class='dropdown-menu dropdown-menu-right'>" +

                                                "<a href='" +
                                                    issueUrl +
                                                    "' " +
                                                    "class='dropdown-item text-success'>" +

                                                    "<i class='icon-checkmark3 mr-2'></i>" +

                                                    " Issue Requisition" +

                                                "</a>" +

                                            "</div>" +

                                        "</div>" +

                                    "</div>"
                                );
                            }
                    }

                ],


                // -------------------------------------------------
                // DEFAULT SORT
                // -------------------------------------------------

                order: [
                    [0, "desc"]
                ],


                // -------------------------------------------------
                // LANGUAGE
                // -------------------------------------------------

                language: {

                    processing:
                        "Loading...",

                    emptyTable:
                        "No approved requisition available for issue.",

                    zeroRecords:
                        "No matching approved requisition found."
                }

            });
    }


    // =============================================================
    // DOCUMENT READY
    // =============================================================

    $(document).ready(function () {

        UpdateDataTable();

    });

    </script>
}