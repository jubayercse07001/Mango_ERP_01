@using ERP.Models.HR.Common.HrBloodGroup;

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- Page header -->
<div class="page-header page-header-light ">


    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
                <span class="breadcrumb-item active">HrBloodGroup</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>

        <div class="header-elements d-none">
            <div class="breadcrumb justify-content-center">



            </div>
        </div>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <!-- Individual column searching (text inputs) -->
    <div class="card">
        <div class="card-header header-elements-inline">
            <h5 class="card-title">List of Blood Groups</h5>
            <div class="header-elements">
                <a href="Javascript:$('#my-form').toggle()"><button type="button" class="btn btn-light mr-3 text-success"> <i class="icon-search4 mr-2 "></i>Advance Search</button></a>
                <a href="@Url.Action("Index", "HrBloodGroup")" class="text-danger-300"><button type="button" class="btn btn-light mr-3 text-danger-300"> <i class="icon-reset mr-2 "></i>Reset Search</button></a>

                <button type="button" class="btn btn-light"> <a href="@Url.Action("Add", "HrBloodGroup")"><i class="icon-add mr-2"></i>Add New</a></button>
            </div>
        </div>

        <form action="" id="my-form" style="display:none">
            <div class="card-body row">




            </div>

            <div class="card-footer bg-white">
                <div class="row" mb-0>
                    <div class="col-lg-12 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="Javascript:$('#my-form').toggle();"><button type="button" class="btn btn-light text-brown-300"> Close Search Pannel</button></a>
                            <a href="javascript:ResetSearch();" class=""><button type="button" class="btn btn-light text-danger-300"> Reset Search</button></a>
                        </div>
                    </div>
                </div>
            </div>
            <hr />
        </form>


        <table class="table dataTable datatable-column-search-inputs" id="BloodGroupItemList">
            <thead>
                <tr>
                    <th>Blood Group ID</th>
                    <th>Blood Group Name</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
            </tbody>
            <tfoot>
                <tr>
                    <td>Blood Group ID</td>
                    <td>Blood Group Name</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <!-- /individual column searching (text inputs) -->



</div>
<!-- /content area -->


@section ChildpageJavaScript{
    <script>

          function ReloadDataTable() {
            dtTable.ajax.url("@Url.Action("GetHrBloodGroupItemList", "HrBloodGroup")?" + $("#my-form").serialize()).load();
        }

        function ResetSearch() {
            $("#my-form").trigger("reset");
            ReloadDataTable();
        }
        function UpdateDataTable() {

            dtTable = $('#BloodGroupItemList').DataTable({
                "processing": true,
                "serverSide": true,
                "method": 'GET',
                "ajax":"@Url.Action("GetHrBloodGroupItemList", "HrBloodGroup")?" + $("#my-form").serialize(),
                columns: [
                    { data: 'BloodGroupId' },
                   { data: 'BloodGroupName' },

                    {
                        "mData": "RowId",
                        "mRender": function (data, type, row) {

                            var retVal = "<div class=\"list-icons\"> <div class=\"dropdown\">" +
                                "<a href=\"#\" class=\"list-icons-item\" data-toggle=\"dropdown\"> <i class=\"icon-menu9\"></i></a>" +
                                "<div class=\"dropdown-menu dropdown-menu-right\">" +
                                    " <a href=\"@Url.Action("Edit", "HrBloodGroup")/"+ data +"\" class=\"dropdown-item text-blue\"><i class=\"icon-pencil7\"></i> Edit Information</a>" +
                                " <a href=\"@Url.Action("Delete", "HrBloodGroup")/" + data +"\" class=\"dropdown-item text-danger\"><i class=\"icon-cross\"></i> Delete Information</a>" +
                                 "  </div></div></div > ";
                            return retVal;
                        }
                    }


                ]
            });
        }



        $(document).ready(function () {

            UpdateDataTable();
        });

    </script>
}

