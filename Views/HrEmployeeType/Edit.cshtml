@using ERP.Models.HR.Organization.HrEmployeeType;

@{
    ViewBag.Title = "Edit Employee Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
    <div class="d-flex">

        <div class="breadcrumb">

            <a href="@Url.Action("Index", "Home")"
               class="breadcrumb-item">
                <i class="icon-home2 mr-2"></i> Home
            </a>

            <a href="@Url.Action("Index", "HrEmployeeType")"
               class="breadcrumb-item">
                HrEmployeeType
            </a>

            <span class="breadcrumb-item active">
                Edit
            </span>

        </div>

    </div>
</div>

<form id="my-form">

    <div class="card" id="maindiv">

        <div class="card-header bg-white header-elements-inline">

            <h6 class="card-title">
                Edit Existing Employee Type
            </h6>

            <input type="hidden"
                   name="RowId"
                   value="@ViewBag.HrEmployeeType.RowId" />

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <!-- Employee Type Name -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            <span class="text-danger">*</span>
                            Employee Type Name
                        </label>

                        <div class="col-lg-8">

                            <input type="text"
                                   name="EmployeeTypeName"
                                   class="form-control"
                                   value="@ViewBag.HrEmployeeType.EmployeeTypeName"
                                   placeholder="Employee Type Name" />

                        </div>

                    </div>

                    <!-- Rank -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            Rank
                        </label>

                        <div class="col-lg-8">

                            <input type="number"
                                   name="Rank"
                                   class="form-control"
                                   value="@ViewBag.HrEmployeeType.Rank" />

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Error Message -->
        <div class="card-footer bg-white"
             id="errordiv"
             style="display:none">

            <div class="row">

                <div class="col-lg-10 ml-lg-auto text-warning"
                     id="errormessage">
                </div>

            </div>

        </div>

        <!-- Success Message -->
        <div class="card-footer bg-white"
             id="successdiv"
             style="display:none">

            <div class="row">

                <div class="col-lg-10 ml-lg-auto text-success">

                    <h4>
                        Employee Type information has been updated successfully.
                    </h4>

                </div>

            </div>

        </div>

        <!-- Buttons -->
        <div class="card-footer bg-white">

            <div class="row">

                <div class="col-lg-12">

                    <div class="d-flex justify-content-between align-items-center">

                        <button type="button"
                                id="btnSubmit"
                                class="btn bg-blue">

                            Submit
                            <i class="icon-paperplane ml-2"></i>

                        </button>

                        <a href="@Url.Action("Index","HrEmployeeType")"
                           class="btn btn-light">

                            Back To List

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>

@section ChildpageJavaScript{

    <script>

$(document).ready(function () {

    $("#btnSubmit").click(function () {

        $.ajax({

            type: "POST",

            url: '@Url.Action("Edit", "HrEmployeeType")',

            data: $("#my-form").serialize(),

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout", "Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index", "HrEmployeeType")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(
                        data.ResponseMessage
                    );

                    $("#successdiv").hide();
                    $("#errordiv").show();

                }
                else {

                    $("#errormessage").html("");

                    $("#errordiv").hide();
                    $("#successdiv").show();

                }
            },

            error: function (xhr) {

                $("#errormessage").html(
                    xhr.responseText
                );

                $("#successdiv").hide();
                $("#errordiv").show();

            }

        });

    });

});

    </script>

}