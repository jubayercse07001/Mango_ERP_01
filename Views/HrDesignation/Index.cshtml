@using ERP.Models.HR.Organization.HrDesignation;

@{
    ViewBag.Title = "Hr Designation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i>
                    Home

                </a>

                <span class="breadcrumb-item active">
                    Hr Designation
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">

                <i class="icon-more"></i>

            </a>

        </div>

        <div class="header-elements d-none">
            <div class="breadcrumb justify-content-center">
            </div>
        </div>

    </div>

</div>

<!-- Content area -->

<div class="content">

    <div class="card">

        <div class="card-header header-elements-inline">

            <h5 class="card-title">
                List of Designations
            </h5>

            <div class="header-elements">

                <a href="Javascript:$('#my-form').toggle()">

                    <button type="button"
                            class="btn btn-light mr-3 text-success">

                        <i class="icon-search4 mr-2"></i>
                        Advance Search

                    </button>

                </a>

                <a href="@Url.Action("Index", "HrDesignation")">

                    <button type="button"
                            class="btn btn-light mr-3 text-danger-300">

                        <i class="icon-reset mr-2"></i>
                        Reset Search

                    </button>

                </a>

                <button type="button"
                        class="btn btn-light">

                    <a href="@Url.Action("Add", "HrDesignation")">

                        <i class="icon-add mr-2"></i>
                        Add New

                    </a>

                </button>

            </div>

        </div>

        <!-- Search Panel -->

        <form id="my-form" style="display:none">

            <div class="card-body row">

                <div class="col-md-4">

                    <div class="form-group">

                        <label>Designation Name</label>

                        <input type="text"
                               name="DesignationName"
                               class="form-control" />

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="form-group">

                        <label>Department</label>

                        <input type="text"
                               name="DepartmentName"
                               class="form-control" />

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="form-group">

                        <label>Employee Type</label>

                        <input type="text"
                               name="EmployeeTypeName"
                               class="form-control" />

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-12 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <a href="Javascript:$('#my-form').toggle();">

                                <button type="button"
                                        class="btn btn-light text-brown-300">

                                    Close Search Panel

                                </button>

                            </a>

                            <a href="javascript:ResetSearch();">

                                <button type="button"
                                        class="btn btn-light text-danger-300">

                                    Reset Search

                                </button>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <hr />

        </form>

        <!-- Data Table -->

        <table class="table dataTable datatable-column-search-inputs"
               id="DesignationItemList">

            <thead>

                <tr>

                    <th>Designation ID</th>
                    <th>Designation Name</th>
                    <th>Short Name</th>
                    <th>Designation Group</th>
                    <th>Job Description</th>
                    <th>Job Specification</th>
                    <th>Rank</th>
                    <th class="text-center">Actions</th>

                </tr>

            </thead>

            <tbody></tbody>

            <tfoot>

                <tr>

                    <td>Designation ID</td>
                    <td>Designation Name</td>
                    <td>Short Name</td>
                    <td>Designation Group</td>
                    <td>Job Description</td>
                    <td>Job Specification</td>
                    <td>Rank</td>
                    <td></td>

                </tr>

            </tfoot>

        </table>

    </div>

</div>

@section ChildpageJavaScript
{

    <script>

    var dtTable;

    function ReloadDataTable() {

        dtTable.ajax.url(
            "@Url.Action("GetHrDesignationItemList", "HrDesignation")?"
            + $("#my-form").serialize()
        ).load();

    }

    function ResetSearch() {

        $("#my-form").trigger("reset");

        ReloadDataTable();

    }

    function UpdateDataTable() {

        dtTable = $('#DesignationItemList').DataTable({

            "processing": true,
            "serverSide": true,
            "method": "GET",

            "ajax":
                "@Url.Action("GetHrDesignationItemList", "HrDesignation")?"
                + $("#my-form").serialize(),

            columns: [

                { data: 'DesignationId' },
                { data: 'DesignationName' },
                { data: 'ShortDesignationName' },
                { data: 'DesignationGroupName' },
                { data: 'JobDescription' },
                { data: 'JobSpecification' },
                { data: 'Rank' },

                {
                    "mData": "RowId",

                    "mRender": function (data, type, row) {

                        var retVal =
                            "<div class='list-icons'>" +
                            "<div class='dropdown'>" +

                            "<a href='#' class='list-icons-item' data-toggle='dropdown'>" +
                            "<i class='icon-menu9'></i>" +
                            "</a>" +

                            "<div class='dropdown-menu dropdown-menu-right'>" +

                            "<a href='@Url.Action("Edit","HrDesignation")/" + data + "' class='dropdown-item text-blue'>" +
                            "<i class='icon-pencil7'></i> Edit Information</a>" +

                            "<a href='@Url.Action("Delete","HrDesignation")/" + data + "' class='dropdown-item text-danger'>" +
                            "<i class='icon-cross'></i> Delete Information</a>" +

                            "</div>" +
                            "</div>" +
                            "</div>";

                        return retVal;
                    }
                }

            ]

        });

    }

    $(document).ready(function () {

        UpdateDataTable();

    });

    </script>

}