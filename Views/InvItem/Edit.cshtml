@using Mango_ERP.Models

@{
    ViewBag.Title = "Edit Inventory Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->

<div class="page-header page-header-light">

     
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i>
                    Home
                </a>

                <a href="@Url.Action("Index", "InvItem")"
                   class="breadcrumb-item">
                    InvItem
                </a>

                <span class="breadcrumb-item active">
                    Edit
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>

        </div>

    </div>
     

</div>
<!-- /page header -->
<!-- Content area -->

<div class="content">

     
    <form id="my-form"
          enctype="multipart/form-data">

        <div class="card"
             id="maindiv">

            <!-- Card Header -->
            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Edit Existing Inventory Item
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.InvItem.RowId" />

                <input type="hidden"
                       name="ItemId"
                       value="@ViewBag.InvItem.ItemId" />

            </div>
            <!-- /card header -->


            <div class="card-body">

                <div class="row">

                    <!-- LEFT COLUMN -->
                    <div class="col-md-6">

                        <!-- Category -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Category
                            </label>

                            <div class="col-lg-8">

                                <select name="CategoryId"
                                        id="CategoryId"
                                        class="form-control">

                                    <option value="">
                                        Select Category
                                    </option>

                                    @if (ViewBag.CategoryList != null)
                                    {
                                        foreach (var item in ViewBag.CategoryList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == ViewBag.InvItem.CategoryId.ToString() ? "selected" : "")>
                                                @item.CategoryName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>
                        <!-- Group -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Group
                            </label>

                            <div class="col-lg-8">

                               
                                <select name="GroupId"
                                        id="GroupId"
                                        class="form-control">

                                    <option value="">
                                        Select Group
                                    </option>

                                    @if (ViewBag.GroupList != null)
                                    {
                                        foreach (var item in ViewBag.GroupList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == ViewBag.InvItem.GroupId.ToString() ? "selected" : "")>
                                                @item.GroupName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>
                        
                        <!-- Class -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Class
                            </label>

                            <div class="col-lg-8">

                                @*<input type="text"
        name="ClassId"
        id="ClassId"
        class="form-control"
        value="@ViewBag.InvItem.ClassId"
        placeholder="Class" />*@
                                <select name="ClassId"
                                        id="ClassId"
                                        class="form-control">

                                    <option value="">
                                        Select Class
                                    </option>

                                    @if (ViewBag.ClassList != null)
                                    {
                                        foreach (var item in ViewBag.ClassList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == ViewBag.InvItem.ClassId.ToString() ? "selected" : "")>
                                                @item.ClassName
                                            </option>
                                        }
                                    }

                                </select>
                            </div>

                        </div>


                        <!-- Family -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Family
                            </label>

                            <div class="col-lg-8">

                                <select name="FamilyId"
                                        id="FamilyId"
                                        class="form-control">

                                    <option value="">
                                        Select Class
                                    </option>

                                    @if (ViewBag.FamilyList != null)
                                    {
                                        foreach (var item in ViewBag.FamilyList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == ViewBag.InvItem.FamilyId.ToString() ? "selected" : "")>
                                                @item.FamilyName
                                            </option>
                                        }
                                    }

                                </select>
                            </div>

                        </div>


                        <!-- Sub Family -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Sub Family
                            </label>

                            <div class="col-lg-8">

                                @*<input type="text"
        name="SubFamilyId"
        id="SubFamilyId"
        class="form-control"
        value="@ViewBag.InvItem.SubFamilyId"
        placeholder="Sub Family" />*@
                                <select name="SubFamilyId"
                                        id="SubFamilyId"
                                        class="form-control">

                                    <option value="">
                                        Select Class
                                    </option>

                                    @if (ViewBag.SubFamilyList != null)
                                    {
                                        foreach (var item in ViewBag.SubFamilyList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == ViewBag.InvItem.SubFamilyId.ToString() ? "selected" : "")>
                                                @item.SubFamilyName
                                            </option>
                                        }
                                    }

                                </select>
                            </div>

                        </div>
                        <!-- Item Code -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Item Code
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="ItemCode"
                                       id="ItemCode"
                                       class="form-control"
                                       value="@ViewBag.InvItem.ItemCode"
                                       placeholder="Item Code" />

                            </div>

                        </div>


                        <!-- Old Item Code -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Old Item Code
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="OldItemCode"
                                       id="OldItemCode"
                                       class="form-control"
                                       value="@ViewBag.InvItem.OldItemCode"
                                       placeholder="Old Item Code" />

                            </div>

                        </div>


                        <!-- Item Name -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Item Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="ItemName"
                                       id="ItemName"
                                       class="form-control"
                                       value="@ViewBag.InvItem.ItemName"
                                       placeholder="Item Name" />

                            </div>

                        </div>


                        <!-- Item Description -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Description
                            </label>

                            <div class="col-lg-8">

                                <textarea name="ItemDescription"
                                          id="ItemDescription"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Item Description">@ViewBag.InvItem.ItemDescription</textarea>

                            </div>

                        </div>
                        <!-- Manufacturer -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Manufacturer
                            </label>

                            <div class="col-lg-8">

                                <select name="ManufacturerId"
                                        id="ManufacturerId"
                                        class="form-control">

                                    <option value="">
                                        Select Manufacturer
                                    </option>

                                    @if (ViewBag.ManufacturerList != null)
                                    {
                                        foreach (var item in ViewBag.ManufacturerList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == Convert.ToString(ViewBag.InvItem.ManufacturerId) ? "selected" : "")>
                                                @item.ManufacturerName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>







                        <!-- Serial Number -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Serial Number
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="SerialNumber"
                                       id="SerialNumber"
                                       class="form-control"
                                       value="@ViewBag.InvItem.SerialNumber"
                                       placeholder="Serial Number" />

                            </div>

                        </div>


                        <!-- Model Number -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Model Number
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="ModelNumber"
                                       id="ModelNumber"
                                       class="form-control"
                                       value="@ViewBag.InvItem.ModelNumber"
                                       placeholder="Model Number" />

                            </div>

                        </div>

                    </div>


                    <!-- RIGHT COLUMN -->
                    <div class="col-md-6">

                        <!-- Minimum Reorder Level -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Minimum Reorder Level
                            </label>

                            <div class="col-lg-8">

                                <input type="number"
                                       step="0.01"
                                       name="MinimumReOrderLevel"
                                       id="MinimumReOrderLevel"
                                       class="form-control"
                                       value="@ViewBag.InvItem.MinimumReOrderLevel" />

                            </div>

                        </div>


                        <!-- Maximum Reorder Level -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Maximum Reorder Level
                            </label>

                            <div class="col-lg-8">

                                <input type="number"
                                       step="0.01"
                                       name="MaximumReOrderLevel"
                                       id="MaximumReOrderLevel"
                                       class="form-control"
                                       value="@ViewBag.InvItem.MaximumReOrderLevel" />

                            </div>

                        </div>


                        <!-- Country -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Country
                            </label>

                            <div class="col-lg-8">

                                <select name="CountryId"
                                        id="CountryId"
                                        class="form-control">

                                    <option value="">
                                        Select Country
                                    </option>

                                    @if (ViewBag.CountryList != null)
                                    {
                                        foreach (var item in ViewBag.CountryList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId.ToString() == Convert.ToString(ViewBag.InvItem.CountryId) ? "selected" : "")>
                                                @item.CountryName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>


                        <!-- Minimum Unit -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Minimum Unit
                            </label>

                            <div class="col-lg-8">
                                <select name="MinimumUnitId" id="MinimumUnitId" class="form-control">
                                    <option value=""> Select Minimum Unit </option> @if (ViewBag.UnitList != null)
                                    {
                                        foreach (var item in ViewBag.UnitList)
                                        {
                                            <option value="@item.RowId" @(Convert.ToString(item.RowId) == Convert.ToString(ViewBag.InvItem.MinimumUnitId) ? "selected" : "")>
                                                @item.MinUnitName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                        </div>


                        <!-- Registered Unit -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Registered Unit
                            </label>

                            <div class="col-lg-8">
                                <select name="RegisteredUnitId"
                                        id="RegisteredUnitId"
                                        class="form-control">

                                    <option value="">Select Registered Unit</option>

                                    @if (ViewBag.UnitList != null)
                                    {
                                        foreach (var item in ViewBag.UnitList)
                                        {
                                            var rowId = Convert.ToString(item.RowId);

                                            var registeredUnitId = "";
                                            if (ViewBag.InvItem != null)
                                            {
                                                registeredUnitId =
                                                    Convert.ToString(ViewBag.InvItem.RegisteredUnitId);
                                            }

                                            <option value="@rowId"
                                                    @(rowId == registeredUnitId ? "selected" : "")>
                                                @item.MinUnitName
                                            </option>
}
                                    }

                                </select>
                            </div>
                        </div>


                        <!-- Sale Unit -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Sale Unit
                            </label>

                            <div class="col-lg-8">
                                <select name="SaleUnitId"
                                        id="SaleUnitId"
                                        class="form-control">

                                    <option value="">Select Sale Unit</option>

                                    @if (ViewBag.UnitList != null)
                                    {
                                        foreach (var item in ViewBag.UnitList)
                                        {
                                            var rowId = Convert.ToString(item.RowId);

                                            var saleUnitId = "";
                                            if (ViewBag.InvItem != null)
                                            {
                                                saleUnitId = Convert.ToString(ViewBag.InvItem.SaleUnitId);
                                            }

                                            <option value="@rowId"
                                                    @(rowId == saleUnitId ? "selected" : "")>
                                                @item.MinUnitName
                                            </option>
                                        }
                                    }

                                </select>
                            </div>
                        </div>


                        <!-- Purchase Unit -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Purchase Unit
                            </label>

                            <div class="col-lg-8">
                                <select name="PurchaseUnitId"
                                        id="PurchaseUnitId"
                                        class="form-control">

                                    <option value="">Select Purchase Unit</option>

                                    @if (ViewBag.UnitList != null)
                                    {
                                        foreach (var item in ViewBag.UnitList)
                                        {
                                            var rowId = Convert.ToString(item.RowId);

                                            var purchaseUnitId = "";

                                            if (ViewBag.InvItem != null)
                                            {
                                                purchaseUnitId =
                                                    Convert.ToString(ViewBag.InvItem.PurchaseUnitId);
                                            }

                        <option value="@rowId"
                                @(rowId == purchaseUnitId ? "selected" : "")>
                            @item.MinUnitName
                        </option>                }
                                    }

                                </select>
                            </div>
                        </div>




                        <!-- Batch Number -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Batch Number
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="BatchNumber"
                                       id="BatchNumber"
                                       class="form-control"
                                       value="@ViewBag.InvItem.BatchNumber"
                                       placeholder="Batch Number" />

                            </div>

                        </div>


                        <!-- Stock Item -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Stock Item
                            </label>

                            <div class="col-lg-8">

                                <select name="IsStockItem"
                                        id="IsStockItem"
                                        class="form-control">

                                    <option value="1"
                                            @(Convert.ToString(ViewBag.InvItem.IsStockItem) == "1" ? "selected" : "")>
                                        Yes
                                    </option>

                                    <option value="0"
                                            @(Convert.ToString(ViewBag.InvItem.IsStockItem) == "0" ? "selected" : "")>
                                        No
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- Item Image -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Item Image
                            </label>

                            <div class="col-lg-8">

                                <input type="file"
                                       name="ItemImageFile"
                                       id="ItemImageFile"
                                       class="form-control"
                                       accept="image/*" />

                                @if (ViewBag.InvItem.ItemImage != null)
                                {
                                    <small class="text-muted">
                                        Existing image is available.
                                        Select a new image only if you want to replace it.
                                    </small>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ERROR -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>


            <!-- SUCCESS -->
            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h4>
                            Inventory Item has been updated successfully.
                        </h4>

                    </div>

                </div>

            </div>


            <!-- BUTTONS -->
            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <button type="button"
                            id="btnSubmit"
                            class="btn bg-blue">

                        Update
                        <i class="icon-paperplane ml-2"></i>

                    </button>

                    <a href="@Url.Action("Index", "InvItem")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

    </form>
     

</div>

@section ChildpageJavaScript
{

    <script>

$(document).ready(function () {

    $("#btnSubmit").click(function () {

        var formData = new FormData($("#my-form")[0]);

        $("#btnSubmit").prop("disabled", true);

        $.ajax({

            type: "POST",

            url: '@Url.Action("Edit", "InvItem")',

            data: formData,

            processData: false,

            contentType: false,

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout", "Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index", "InvItem")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(
                        data.ResponseMessage
                    );

                    $("#successdiv").hide();

                    $("#errordiv").show();

                    $("#btnSubmit").prop("disabled", false);

                }
                else {

                    $("#errormessage").html("");

                    $("#errordiv").hide();

                    $("#successdiv").show();

                    $("#btnSubmit").hide();

                }

            },

            error: function (xhr) {

                var message = "An unexpected error occurred.";

                if (xhr.responseText) {
                    message = xhr.responseText;
                }

                $("#errormessage").html(message);

                $("#successdiv").hide();

                $("#errordiv").show();

                $("#btnSubmit").prop("disabled", false);

            }

        });

    });

});

    </script>

}
