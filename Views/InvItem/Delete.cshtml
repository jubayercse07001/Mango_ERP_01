@using Mango_ERP.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Item";
}

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index", "InvItem")"
                   class="breadcrumb-item">
                    InvItem
                </a>

                <span class="breadcrumb-item active">
                    Delete
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>

        </div>

    </div>

</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <form action="#"
          id="my-form">

        <div class="card"
             id="maindiv">

            <!-- Card Header -->
            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Delete Existing Item
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.InvItem.RowId" />

            </div>


            <!-- Warning -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-danger">

                        <h2>
                            Are you sure you want to delete the following Item?
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Item Information -->
            <div class="card-body">

                <!-- Item ID -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Item ID:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ItemId
                    </div>

                </div>


                <!-- Item Code -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Item Code:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ItemCode
                    </div>

                </div>


                <!-- Old Item Code -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Old Item Code:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.OldItemCode
                    </div>

                </div>


                <!-- Item Name -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Item Name:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ItemName
                    </div>

                </div>


                <!-- Description -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Item Description:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ItemDescription
                    </div>

                </div>


                <!-- Category -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Category:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.CategoryName
                    </div>

                </div>


                <!-- Group -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Group:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.GroupName
                    </div>

                </div>


                <!-- Class -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Class:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ClassName
                    </div>

                </div>


                <!-- Family -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Family:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.FamilyName
                    </div>

                </div>


                <!-- Sub Family -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Sub Family:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.SubFamilyName
                    </div>

                </div>


                <!-- Serial Number -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Serial Number:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.SerialNumber
                    </div>

                </div>


                <!-- Model Number -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Model Number:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ModelNumber
                    </div>

                </div>


                <!-- Minimum Re-Order Level -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Minimum Re-Order Level:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.MinimumReOrderLevel
                    </div>

                </div>


                <!-- Maximum Re-Order Level -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Maximum Re-Order Level:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.MaximumReOrderLevel
                    </div>

                </div>


                <!-- Country -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Country:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.CountryName
                    </div>

                </div>


                


                <!-- Manufacturer -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Manufacturer:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.ManufacturerName
                    </div>

                </div>


                <!-- Batch Number -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Batch Number:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvItem.BatchNumber
                    </div>

                </div>


                <!-- Stock Item -->
                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Stock Item:
                    </label>

                    <div class="col-lg-9 pt-2">

                        @if (ViewBag.InvItem.IsStockItem == 1)
                        {
                            <span class="badge badge-success">
                                Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">
                                No
                            </span>
                        }

                    </div>

                </div>

            </div>


            <!-- Error -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>


            <!-- Success -->
            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h2>
                            Item has been deleted successfully.
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Buttons -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <button type="button"
                                    id="btnSubmit"
                                    class="btn bg-danger">

                                Delete
                                <i class="icon-cross ml-2"></i>

                            </button>


                            <a href="@Url.Action("Index", "InvItem")"
                               class="btn btn-light">

                                Back to List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>
<!-- /content area -->


@section ChildpageJavaScript{

    <script>

$(document).ready(function () {

    $("#btnSubmit").click(function () {

        if (!confirm("Are you sure you want to delete this Item?")) {
            return;
        }

        $.ajax({

            type: "POST",

            url: '@Url.Action("Delete", "InvItem")',

            data: $("#my-form").serialize(),

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout", "Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index", "InvItem")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(
                        data.ResponseMessage
                    );

                    $("#successdiv").hide();
                    $("#errordiv").show();

                }
                else {

                    $("#errormessage").html("");

                    $("#errordiv").hide();

                    $("#btnSubmit").hide();

                    $("#successdiv").show();

                }

            },

            error: function (xhr) {

                $("#errormessage").html(
                    "An error occurred while deleting the Item."
                );

                $("#successdiv").hide();
                $("#errordiv").show();

            }

        });

    });

});

    </script>

}