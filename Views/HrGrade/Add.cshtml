@using ERP.Models.HR.Organization.HrGrade

@{
    ViewBag.Title = "Add Grade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index","Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i>
                    Home

                </a>

                <a href="@Url.Action("Index","HrGrade")"
                   class="breadcrumb-item">

                    HrGrade

                </a>

                <span class="breadcrumb-item active">
                    Add
                </span>

            </div>

        </div>

    </div>

</div>

<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Add New Grade
                </h6>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Employee Type
                            </label>

                            <div class="col-lg-8">

                                <select name="EmployeeTypeId"
                                        id="EmployeeTypeId"
                                        class="form-control">

                                    <option value="">
                                        Select Employee Type
                                    </option>

                                    @foreach (var item in ViewBag.EmployeeTypeList)
                                    {
                                        <option value="@item.RowId">
                                            @item.EmployeeTypeName
                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Grade Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="GradeName"
                                       class="form-control"
                                       placeholder="Grade Name" />

                            </div>

                        </div>

                        @*<div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Pay Scale
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="PayScale"
                                       class="form-control"
                                       placeholder="Pay Scale" />

                            </div>

                        </div>*@

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Rank
                            </label>

                            <div class="col-lg-8">

                                <input type="number"
                                       name="Rank"
                                       class="form-control"
                                       value="0" />

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <button type="button"
                            id="btnSubmit"
                            class="btn bg-blue">

                        Submit
                        <i class="icon-paperplane ml-2"></i>

                    </button>

                    <a href="@Url.Action("Index","HrGrade")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

        <div class="card"
             id="successdiv"
             style="display:none">

            <div class="card-header bg-white">

                <h6 class="card-title">
                    Grade Added Successfully
                </h6>

            </div>

            <div class="card-body">

                <h4 class="text-success">
                    Grade information has been added successfully.
                </h4>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <a href="@Url.Action("Add","HrGrade")"
                       class="btn btn-light">

                        Add Another

                    </a>

                    <a href="@Url.Action("Index","HrGrade")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>
            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript
{
    <script>

        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({

                    type: "POST",

                    url: '@Url.Action("Add", "HrGrade")',

                    data: $("#my-form").serialize(),

                    success: function (data) {

                        if (data.ResponseStatus == -1) {

                            window.location.href =
                                '@Url.Action("Logout","Login")';

                        }
                        else if (data.ResponseStatus == -2) {

                            window.location.href =
                                '@Url.Action("Index","HrGrade")';

                        }
                        else if (data.ResponseStatus == 0) {

                            $("#errormessage").html(
                                data.ResponseMessage
                            );

                            $("#errordiv").show();

                        }
                        else {

                            $("#errordiv").hide();

                            $("#maindiv").hide();

                            $("#successdiv").show();

                        }

                    }

                });

            });

        });

    </script>
}