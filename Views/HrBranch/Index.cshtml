@using ERP.Models.HR.Organization.HrBranch;

@{
    ViewBag.Title = "Hr Branch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->

<div class="page-header page-header-light">

    ```
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i>
                    Home

                </a>

                <span class="breadcrumb-item active">
                    Hr Branch
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">

                <i class="icon-more"></i>

            </a>

        </div>

        <div class="header-elements d-none">
            <div class="breadcrumb justify-content-center">
            </div>
        </div>

    </div>
    ```

</div>

<!-- Content area -->

<div class="content">

    ```
    <div class="card">

        <div class="card-header header-elements-inline">

            <h5 class="card-title">
                List of Branches
            </h5>

            <div class="header-elements">

                <a href="Javascript:$('#my-form').toggle()">

                    <button type="button"
                            class="btn btn-light mr-3 text-success">

                        <i class="icon-search4 mr-2"></i>
                        Advance Search

                    </button>

                </a>

                <a href="@Url.Action("Index", "HrBranch")">

                    <button type="button"
                            class="btn btn-light mr-3 text-danger-300">

                        <i class="icon-reset mr-2"></i>
                        Reset Search

                    </button>

                </a>

                <button type="button"
                        class="btn btn-light">

                    <a href="@Url.Action("Add", "HrBranch")">

                        <i class="icon-add mr-2"></i>
                        Add New

                    </a>

                </button>

            </div>

        </div>

        <form id="my-form" style="display:none">

            <div class="card-body row">
            </div>

            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-12 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <a href="Javascript:$('#my-form').toggle();">

                                <button type="button"
                                        class="btn btn-light text-brown-300">

                                    Close Search Panel

                                </button>

                            </a>

                            <a href="javascript:ResetSearch();">

                                <button type="button"
                                        class="btn btn-light text-danger-300">

                                    Reset Search

                                </button>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <hr />

        </form>

        <table class="table dataTable datatable-column-search-inputs"
               id="BranchItemList">

            <thead>

                <tr>

                    <th>Branch ID</th>
                    <th>Branch Name</th>
                    <th>Short Name</th>
                    <th>Division Name</th>
                    <th>Contact Number</th>
                    <th>Rank</th>
                    <th class="text-center">Actions</th>

                </tr>

            </thead>

            <tbody></tbody>

            <tfoot>

                <tr>

                    <td>Branch ID</td>
                    <td>Branch Name</td>
                    <td>Short Name</td>
                    <td>Division Name</td>
                    <td>Contact Number</td>
                    <td>Rank</td>
                    <td></td>

                </tr>

            </tfoot>

        </table>

    </div>
    ```

</div>

@section ChildpageJavaScript
{

    <script>

    var dtTable;

    function ReloadDataTable() {

        dtTable.ajax.url(
            "@Url.Action("GetHrBranchItemList", "HrBranch")?"
            + $("#my-form").serialize()
        ).load();

    }

    function ResetSearch() {

        $("#my-form").trigger("reset");

        ReloadDataTable();

    }

    function UpdateDataTable() {

        dtTable = $('#BranchItemList').DataTable({

            "processing": true,
            "serverSide": true,
            "method": "GET",

            "ajax":
                "@Url.Action("GetHrBranchItemList", "HrBranch")?"
                + $("#my-form").serialize(),

            columns: [

                { data: 'BranchId' },
                { data: 'BranchName' },
                { data: 'ShortBranchName' },
                { data: 'DivisionName' },
                { data: 'ContactNumber' },
                { data: 'Rank' },

                {
                    "mData": "RowId",

                    "mRender": function (data, type, row) {

                        var retVal =
                            "<div class='list-icons'>" +
                            "<div class='dropdown'>" +

                            "<a href='#' class='list-icons-item' data-toggle='dropdown'>" +
                            "<i class='icon-menu9'></i>" +
                            "</a>" +

                            "<div class='dropdown-menu dropdown-menu-right'>" +

                            "<a href='@Url.Action("Edit","HrBranch")/" + data + "' class='dropdown-item text-blue'>" +
                            "<i class='icon-pencil7'></i> Edit Information</a>" +

                            "<a href='@Url.Action("Delete","HrBranch")/" + data + "' class='dropdown-item text-danger'>" +
                            "<i class='icon-cross'></i> Delete Information</a>" +

                            "</div>" +
                            "</div>" +
                            "</div>";

                        return retVal;
                    }
                }

            ]

        });

    }

    $(document).ready(function () {

        UpdateDataTable();

    });

    </script>

}
