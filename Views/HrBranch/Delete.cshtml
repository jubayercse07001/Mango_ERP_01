@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Branch";
}

<!-- Page header -->

<div class="page-header page-header-light">

    ```
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index", "HrBranch")"
                   class="breadcrumb-item">
                    HrBranch
                </a>

                <span class="breadcrumb-item active">
                    Delete
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>

        </div>
    </div>
    ```

</div>

<!-- Content area -->

<div class="content">

    ```
    <form action="#"
          id="my-form">

        <div class="card"
             id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Delete Existing Branch
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.HrBranch.RowId" />

            </div>

            <!-- WARNING -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-danger">

                        <h2>
                            Are you sure you want to delete the following Branch?
                        </h2>

                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Branch ID:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.BranchId
                    </div>

                </div>

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Branch Name:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.BranchName
                    </div>

                </div>

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Short Name:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.ShortBranchName
                    </div>

                </div>

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Division:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.DivisionName
                    </div>

                </div>

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Address:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.BranchAddress
                    </div>

                </div>

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Contact Number:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.ContactNumber
                    </div>

                </div>

                <div class="form-group row mb-0">

                    <label class="col-form-label col-lg-3">
                        Rank:
                    </label>

                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrBranch.Rank
                    </div>

                </div>

            </div>

            <!-- ERROR DIV -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>

            <!-- SUCCESS DIV -->
            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h2>
                            Branch has been deleted successfully.
                        </h2>

                    </div>

                </div>

            </div>

            <!-- BUTTONS -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <button type="button"
                                    id="btnSubmit"
                                    class="btn bg-danger ml-3">

                                Delete
                                <i class="icon-cross ml-2"></i>

                            </button>

                            <a href="@Url.Action("Index", "HrBranch")"
                               class="btn btn-light">

                                Back to List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>
    ```

</div>

@section ChildpageJavaScript{

    <script>

$(document).ready(function () {

    $("#btnSubmit").click(function () {

        $.ajax({

            type: "POST",

            url: '@Url.Action("Delete", "HrBranch")',

            data: $("#my-form").serialize(),

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout", "Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index", "HrBranch")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(data.ResponseMessage);

                    $("#successdiv").hide();
                    $("#errordiv").show();

                }
                else {

                    $("#errormessage").html("");

                    $("#errordiv").hide();

                    $("#btnSubmit").hide();

                    $("#successdiv").show();

                }
            },

            error: function (xhr) {

                $("#errormessage").html(xhr.responseText);

                $("#successdiv").hide();
                $("#errordiv").show();

            }

        });

    });

});

    </script>

}
