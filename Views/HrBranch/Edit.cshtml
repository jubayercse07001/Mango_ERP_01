@using ERP.Models.HR.Organization.HrBranch;

@{
    ViewBag.Title = "Edit Branch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
    <div class="d-flex">

        
        <div class="breadcrumb">

            <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                <i class="icon-home2 mr-2"></i> Home
            </a>

            <a href="@Url.Action("Index", "HrBranch")"
               class="breadcrumb-item">
                HrBranch
            </a>

            <span class="breadcrumb-item active">Edit</span>

        </div>

    </div>
  

</div>

<form id="my-form">

    
    <div class="card" id="maindiv">

        <div class="card-header bg-white header-elements-inline">

            <h6 class="card-title">
                Edit Existing Branch
            </h6>

            <input type="hidden"
                   name="RowId"
                   value="@ViewBag.HrBranch.RowId" />

        </div>

        <div class="card-body">

            <div class="row">

                <!-- Left Column -->
                <div class="col-md-6">

                    <!-- Division -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            <span class="text-danger">*</span>
                            Division
                        </label>

                        <div class="col-lg-8">

                            <select name="DivisionId"
                                    id="DivisionId"
                                    class="form-control">

                                <option value="">
                                    Select Division
                                </option>

                                @foreach (var item in ViewBag.DivisionList)
                                {
                                    <option value="@item.RowId"
                                            @(item.RowId == ViewBag.HrBranch.DivisionId ? "selected" : "")>
                                        @item.DivisionName
                                    </option>
                                }

                            </select>

                        </div>

                    </div>

                    <!-- Branch Name -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            <span class="text-danger">*</span>
                            Branch Name
                        </label>

                        <div class="col-lg-8">

                            <input type="text"
                                   name="BranchName"
                                   class="form-control"
                                   value="@ViewBag.HrBranch.BranchName"
                                   placeholder="Branch Name" />

                        </div>

                    </div>

                    <!-- Short Branch Name -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            Short Name
                        </label>

                        <div class="col-lg-8">

                            <input type="text"
                                   name="ShortBranchName"
                                   class="form-control"
                                   value="@ViewBag.HrBranch.ShortBranchName"
                                   placeholder="Short Branch Name" />

                        </div>

                    </div>

                </div>

                <!-- Right Column -->
                <div class="col-md-6">

                    <!-- Branch Address -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            Address
                        </label>

                        <div class="col-lg-8">

                            <textarea name="BranchAddress"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Branch Address">@ViewBag.HrBranch.BranchAddress</textarea>

                        </div>

                    </div>

                    <!-- Contact Number -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            Contact Number
                        </label>

                        <div class="col-lg-8">

                            <input type="text"
                                   name="ContactNumber"
                                   class="form-control"
                                   value="@ViewBag.HrBranch.ContactNumber"
                                   placeholder="Contact Number" />

                        </div>

                    </div>

                    <!-- Rank -->
                    <div class="form-group row">

                        <label class="col-lg-4 col-form-label">
                            Rank
                        </label>

                        <div class="col-lg-8">

                            <input type="number"
                                   name="Rank"
                                   class="form-control"
                                   value="@ViewBag.HrBranch.Rank" />

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Error Message -->
        <div class="card-footer bg-white"
             id="errordiv"
             style="display:none">

            <div class="row">

                <div class="col-lg-10 ml-lg-auto text-warning"
                     id="errormessage">
                </div>

            </div>

        </div>

        <!-- Success Message -->
        <div class="card-footer bg-white"
             id="successdiv"
             style="display:none">

            <div class="row">

                <div class="col-lg-10 ml-lg-auto text-success">

                    <h2>
                        Branch information has been updated successfully.
                    </h2>

                </div>

            </div>

        </div>

        <!-- Buttons -->
        <div class="card-footer bg-white">

            <div class="row">

                <div class="col-lg-12">

                    <div class="d-flex justify-content-between align-items-center">

                        <button type="button"
                                id="btnSubmit"
                                class="btn bg-blue">

                            Submit
                            <i class="icon-paperplane ml-2"></i>

                        </button>

                        <a href="@Url.Action("Index","HrBranch")"
                           class="btn btn-light">

                            Back To List

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
   

</form>

@section ChildpageJavaScript{

    <script>

    $(document).ready(function () {

        $("#btnSubmit").click(function () {

            var formData = new FormData($('#my-form')[0]);

            $.ajax({

                type: "POST",

                url: '@Url.Action("Edit", "HrBranch")',

                data: formData,

                processData: false,
                contentType: false,

                success: function (data) {

                    if (data.ResponseStatus == -1) {

                        window.location.href =
                            '@Url.Action("Logout", "Login")';

                    }
                    else if (data.ResponseStatus == -2) {

                        window.location.href =
                            '@Url.Action("Index", "HrBranch")';

                    }
                    else if (data.ResponseStatus == 0) {

                        $("#errormessage").html(data.ResponseMessage);

                        $("#successdiv").hide();
                        $("#errordiv").show();

                    }
                    else {

                        $("#errormessage").html("");

                        $("#errordiv").hide();
                        $("#successdiv").show();

                    }
                },

                error: function (xhr, status, error) {

                    console.log(xhr.responseText);

                    $("#errormessage").html(xhr.responseText);

                    $("#successdiv").hide();
                    $("#errordiv").show();
                }

            });

        });

    });

    </script>

}
