@using Mango_ERP.Models;

@{
    ViewBag.Title = "Add Employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index","Home")" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
                <a href="@Url.Action("Index","HrEmployee")" class="breadcrumb-item">HrEmployee</a>
                <span class="breadcrumb-item active">Add</span>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <form id="my-form" enctype="multipart/form-data">
        <div class="card" id="maindiv">
            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Add New Employee</h6>
            </div>

            <ul class="nav nav-tabs nav-tabs-bottom nav-justified mb-0">
                <li class="nav-item"><a href="#tab-basic" class="nav-link active" data-toggle="tab">Basic Info</a></li>
                <li class="nav-item"><a href="#tab-detail" class="nav-link" data-toggle="tab">Detail Info</a></li>
                <li class="nav-item"><a href="#tab-education" class="nav-link" data-toggle="tab">Education Info</a></li>
                <li class="nav-item"><a href="#tab-experience" class="nav-link" data-toggle="tab">Experience Info</a></li>
                <li class="nav-item"><a href="#tab-training" class="nav-link" data-toggle="tab">Training Info</a></li>
                <li class="nav-item"><a href="#tab-knowledge" class="nav-link" data-toggle="tab">Professional Knowledge</a></li>
                <li class="nav-item"><a href="#tab-reference" class="nav-link" data-toggle="tab">Reference Info</a></li>
                <li class="nav-item"><a href="#tab-picture" class="nav-link" data-toggle="tab">Picture Info</a></li>
            </ul>

            <div class="card-body tab-content">
                <!-- ====================================== BASIC INFO ==================== -->
                <div class="tab-pane fade show active" id="tab-basic">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    <span class="text-danger">*</span> Company
                                </label>
                                <div class="col-lg-8">
                                    <select name="CompanyId" id="CompanyId" class="form-control">
                                        <option value="">Select Company</option>
                                        @foreach (var item in ViewBag.CompanyList)
                                        {
                                            <option value="@item.RowId">@item.CompanyName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    <span class="text-danger">*</span> Division
                                </label>
                                <div class="col-lg-8">
                                    <select name="DivisionId" id="DivisionId" class="form-control">
                                        <option value="">Select Division</option>
                                    </select>

                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    <span class="text-danger">*</span> Branch
                                </label>
                                <div class="col-lg-8">
                                    <select name="BranchId" id="BranchId" class="form-control">
                                        <option value="">Select Branch</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    <span class="text-danger">*</span> Department
                                </label>
                                <div class="col-lg-8">
                                    <select name="DepartmentId" id="DepartmentId" class="form-control">
                                        <option value="">Select Department</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    <span class="text-danger">*</span>Designation
                                </label>
                                <div class="col-lg-8">
                                    <select name="DesignationId" id="DesignationId" class="form-control">
                                        <option value="">Select Designation</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Employee Type</label>
                                <div class="col-lg-8">
                                    <select name="EmployeeTypeId" class="form-control">
                                        <option value="">Select Employee Type</option>
                                        @if (ViewBag.EmployeeTypeList != null)
                                        {
                                            foreach (var item in ViewBag.EmployeeTypeList)
                                            {
                                                <option value="@item.RowId">@item.EmployeeTypeName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Employeement Type</label>
                                <div class="col-lg-8">
                                    <select name="JobType" class="form-control">
                                        <option value="">Select Employeement Type</option>
                                        @if (ViewBag.JobTypeList != null)
                                        {
                                            foreach (var item in ViewBag.JobTypeList)
                                            {
                                                <option value="@item.RowId">@item.JobType</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label"><span class="text-danger">*</span> Staff Code</label>
                                <div class="col-lg-8">
                                    <input type="text" name="StaffCode" class="form-control" placeholder="Staff Code" required />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Title</label>
                                <div class="col-lg-8">
                                    <input type="text" name="Title" class="form-control" placeholder="E.g. Mr. / Ms." />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label"><span class="text-danger">*</span> First Name</label>
                                <div class="col-lg-8">
                                    <input type="text" name="FirstName" class="form-control" placeholder="First Name" required />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Middle Name</label>
                                <div class="col-lg-8">
                                    <input type="text" name="MiddleName" class="form-control" placeholder="Middle Name" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Last Name</label>
                                <div class="col-lg-8">
                                    <input type="text" name="LastName" class="form-control" placeholder="Last Name" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Present Address</label>
                                <div class="col-lg-8">
                                    <textarea name="PresentAddress" class="form-control" rows="2" placeholder="Present Address"></textarea>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Permanent Address</label>
                                <div class="col-lg-8">
                                    <textarea name="PermanentAddress" class="form-control" rows="2" placeholder="Permanent Address"></textarea>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Blood Group</label>
                                <div class="col-lg-8">
                                    <select name="BloodGroupId" id="BloodGroupId" class="form-control">
                                        <option value="">Select Blood Group</option>
                                        @if (ViewBag.BloodGroupList != null)
                                        {
                                            foreach (var item in ViewBag.BloodGroupList)
                                            {

                                                <option value="@item.RowId">@item.BloodGroupName</option>

                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Date Of Birth</label>
                                <div class="col-lg-8">
                                    <input type="date" name="DateOfBirth" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Nationality</label>
                                <div class="col-lg-8">
                                    <select name="NationalityId" id="NationalityId" class="form-control">
                                        <option value="">Select Nationality</option>
                                        @if (ViewBag.NationalityList != null)
                                        {
                                            foreach (var item in ViewBag.NationalityList)
                                            {

                                                <option value="@item.RowId">@item.NationalityName</option>

                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">National ID (NID)</label>
                                <div class="col-lg-8">
                                    <input type="text" name="NationalIdNumber" class="form-control" placeholder="NID Number" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Home Phone</label>
                                <div class="col-lg-8">
                                    <input type="text" name="HomePhone" class="form-control" placeholder="Home Phone" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Cell Phone</label>
                                <div class="col-lg-8">
                                    <input type="text" name="CellPhone" class="form-control" placeholder="Cell Phone" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Office Phone</label>
                                <div class="col-lg-8">
                                    <input type="text" name="OfficePhone" class="form-control" placeholder="Office Phone" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Primary Email</label>
                                <div class="col-lg-8">
                                    <input type="email" name="PrimaryEmail" class="form-control" placeholder="Primary Email" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Alternate Email</label>
                                <div class="col-lg-8">
                                    <input type="email" name="AlternateEmail" class="form-control" placeholder="Alternate Email" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Gender</label>
                                <div class="col-lg-8">
                                    <select name="Gender" class="form-control">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">


                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Religion</label>
                                <div class="col-lg-8">
                                    <select name="ReligionId" class="form-control">
                                        <option value="">Select Religion</option>
                                        @if (ViewBag.ReligionList != null)
                                        {
                                            foreach (var item in ViewBag.ReligionList)
                                            {
                                                <option value="@item.RowId">@item.ReligionName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Marital Status</label>
                                <div class="col-lg-8">
                                    <select name="MaritalStatus" class="form-control">
                                        <option value="">Select Marital Status</option>
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Divorced">Divorced</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Date Of Join</label>
                                <div class="col-lg-8">
                                    <input type="date" name="DateOfJoin" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <div class="form-group row align-items-center mb-3">
                                <!-- Main Label -->
                                <label class="col-lg-4 col-form-label">Date Of Permanent</label>

                                <!-- Inputs Container (Flexbox aligns checkbox and date side-by-side) -->
                                <div class="col-lg-8 d-flex align-items-center gap-3">

                                    <!-- Checkbox Wrapper -->
                                    <div class="form-check m-0">
                                        <input type="checkbox"
                                               id="IsPermanent"
                                               class="form-check-input" />
                                        @*<label class="form-check-label ms-1" for="IsPermanent">Permanent</label>*@
                                    </div>

                                    <!-- Date Input with your dynamic server-side value -->
                                    <input type="date"
                                           id="DateOfPermanent"
                                           name="DateOfPermanent"
                                           class="form-control flex-grow-1"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           disabled />
                                </div>
                            </div>
                            <div class="form-group row">
                                <!-- Main Label -->
                                <label class="col-lg-4 col-form-label">Date of Confirmation</label>

                                <!-- Inputs Container (Flexbox aligns checkbox and date side-by-side) -->
                                <div class="col-lg-8 d-flex align-items-center gap-3">

                                    <!-- Checkbox Wrapper -->
                                    <div class="form-check m-0">
                                        <input type="checkbox"
                                               id="IsConfirmed"
                                               name="IsConfirmed"
                                               value="true"
                                               class="form-check-input" />

                                        <!-- Hidden field for ASP.NET boolean binding model -->
                                        <input type="hidden" name="IsConfirmed" value="false" />
                                    </div>

                                    <!-- Date Input with dynamic layout rules applied -->
                                    <input type="date"
                                           id="ConfirmationDate"
                                           name="ConfirmationDate"
                                           class="form-control flex-grow-1"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           disabled />
                                </div>
                            </div>
                            <div class="form-group row align-items-center mb-3">
                                <!-- Main Label -->
                                <label class="col-lg-4 col-form-label">Date Of Retirement</label>

                                <!-- Inputs Container (Flexbox aligns checkbox and date side-by-side) -->
                                <div class="col-lg-8 d-flex align-items-center gap-3">

                                    <!-- Checkbox Wrapper -->
                                    <div class="form-check m-0">
                                        <input type="checkbox"
                                               id="IsRetired"
                                               class="form-check-input" />

                                    </div>

                                    <input type="date"
                                           id="DateOfRetirement"
                                           name="DateOfRetirement"
                                           class="form-control flex-grow-1"
                                           disabled />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Preferred Job Title</label>
                                <div class="col-lg-8">
                                    <input type="text" name="PeferredJob" class="form-control" placeholder="Preferred Job Title" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">User ID</label>
                                <div class="col-lg-8">
                                    <input type="text" name="UserId" class="form-control" placeholder="System User ID" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Rank</label>
                                <div class="col-lg-8">
                                    <input type="text" name="Rank" class="form-control" value="0" />
                                </div>
                            </div>

                            <div class="form-group row pt-2">
                                <label class="col-lg-4 col-form-label">Statuses</label>
                                <div class="col-lg-8">
                                    <div class="form-check form-check-inline">
                                        <label class="form-check-label">
                                            <input type="checkbox" name="IsAdminEmployee" value="Yes" class="form-check-input"> Is Admin
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <label class="form-check-label">
                                            <input type="checkbox" name="IsInLPR" value="Yes" class="form-check-input"> Is In LPR
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row border-top pt-2">
                                <label class="col-lg-4 col-form-label">
                                    Is Salaried
                                </label>
                                <div class="col-lg-8">
                                    <div class="form-check">
                                        <label class="form-check-label">
                                            <input type="checkbox"
                                                   id="IsSalaried"
                                                   name="IsSalaried"
                                                   value="true"
                                                   class="form-check-input" />
                                            Is Salaried
                                        </label>

                                        <input type="hidden" name="IsSalaried" value="false" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Grade</label>
                                <div class="col-lg-8">
                                    <select name="GradeId" id="GradeId" class="form-control">
                                        <option value="">Select Grade</option>
                                        @if (ViewBag.GradeList != null)
                                        {
                                            foreach (var item in ViewBag.GradeList)
                                            {
                                                <option value="@item.RowId">@item.GradeName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Basic Salary</label>
                                <div class="col-lg-8">
                                    <input type="text" name="BasicSalary" id="BasicSalary" class="form-control" placeholder="0.00" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Current Salary</label>
                                <div class="col-lg-8">
                                    <input type="text" name="CurrentSalary" id="CurrentSalary" class="form-control" placeholder="0.00" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Bank Account No</label>
                                <div class="col-lg-8">
                                    <input type="text" name="BankAccountNumber" id="BankAccountNumber" class="form-control" placeholder="Account Number" />
                                </div>
                            </div>

                            <div class="form-group row border-top pt-2">
                                <label class="col-lg-4 col-form-label">
                                    Is Engineer
                                </label>
                                <div class="col-lg-8">
                                    <div class="form-check">
                                        <label class="form-check-label">
                                            <input type="checkbox"
                                                   id="IsEngineer"
                                                   name="IsEngineer"
                                                   value="true"
                                                   class="form-check-input" />
                                            Is Engineer
                                        </label>

                                        <input type="hidden" name="IsEngineer" value="false" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    Engineer Type
                                </label>
                                <div class="col-lg-8">
                                    <select id="EngineerTypeId"
                                            name="EngineerTypeId"
                                            class="form-control">
                                        <option value="">Select Engineer Type</option>

                                        @if (ViewBag.EngineerTypeList != null)
                                        {
                                            foreach (var item in ViewBag.EngineerTypeList)
                                            {
                                                <option value="@item.RowId">
                                                    @item.EngineerTypeName
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="form-group row border-top pt-2">
                                <label class="col-lg-4 col-form-label">
                                    Is Terminated
                                </label>
                                <div class="col-lg-8">
                                    <div class="form-check">
                                        <label class="form-check-label">
                                            <input type="checkbox"
                                                   id="IsTerminated"
                                                   name="IsTerminated"
                                                   value="true"
                                                   class="form-check-input" />
                                            Terminated
                                        </label>
                                        <input type="hidden" name="IsTerminated" value="false" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    Date of Termination
                                </label>
                                <div class="col-lg-8">
                                    <input type="date"
                                           id="TerminateDate"
                                           name="TerminateDate"
                                           class="form-control mb-1"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    Terminated By
                                </label>
                                <div class="col-lg-8">
                                    <input type="text"
                                           id="TerminateBy"
                                           name="TerminateBy"
                                           class="form-control"
                                           placeholder="Enter User/Employee ID" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    Termination Reason
                                </label>
                                <div class="col-lg-8">
                                    <textarea id="TerminateReason"
                                              name="TerminateReason"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter termination reason"></textarea>
                                </div>
                            </div>

                            <div class="form-group row border-top pt-2">
                                <label class="col-lg-4 col-form-label">
                                    Police Verified
                                </label>
                                <div class="col-lg-8">
                                    <div class="form-check">
                                        <label class="form-check-label">
                                            <input type="checkbox"
                                                   id="IsPoliceVerified"
                                                   name="IsPoliceVerified"
                                                   value="true"
                                                   class="form-check-input" />
                                            Verified
                                        </label>
                                        <input type="hidden" name="IsPoliceVerified" value="false" />
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">
                                    Police Verification Number
                                </label>
                                <div class="col-lg-8">
                                    <input type="text"
                                           id="PoliceVerificationNumber"
                                           name="PoliceVerificationNumber"
                                           class="form-control"
                                           placeholder="Enter Verification Reference Number" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- ====================================== END BASIC INFO ==================== -->
                
                <!-- ====================================== DETAIL INFO ==================== -->
                <div class="tab-pane fade" id="tab-detail">

                    <div class="row">

                        <!-- Left Side -->
                        <div class="col-md-6">

                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Father's Name</label>
                                <div class="col-lg-8">
                                    <input type="text" name="EmployeeDetail.FathersName" id="EmployeeDetail.FathersName"
                                           class="form-control" placeholder="Father's Name" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Mother's Name</label>
                                <div class="col-lg-8">
                                    <input type="text" name="EmployeeDetail.MothersName" id="EmployeeDetail.MothersName"
                                           class="form-control" placeholder="Mother's Name" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Spouse Name</label>
                                <div class="col-lg-8">
                                    <input type="text" name="EmployeeDetail.SpouseName" id="EmployeeDetail.SpouseName"
                                           class="form-control" placeholder="Spouse Name" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">Number Of Children</label>
                                <div class="col-lg-8">
                                    <input type="number"
                                           name="EmployeeDetail.NumberOfChildren"
                                           id="EmployeeDetail.NumberOfChildren"
                                           class="form-control"
                                           placeholder="0"
                                           min="0"
                                           step="1"
                                           value="0" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">National ID</label>
                                <div class="col-lg-8">
                                    <input type="text" name="EmployeeDetail.NationalIdNumber"
                                           id="EmployeeDetail.NationalIdNumber"
                                           class="form-control"
                                           placeholder="National ID Number" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-lg-4 col-form-label">City Of Birth</label>
                                <div class="col-lg-8">
