        // ==================== EDUCATION DYNAMIC ROWS ====================
            var educationList = [];

            $(document).ready(function () {

                // Add or Update Entry
                $("#btnAddEducation").click(function () {
                    var degreeId = $.trim($("#EducationalDegreeId").val());
                    var degreeName = $("#EducationalDegreeId option:selected").text().trim();

                    var instituteId = $.trim($("#EducationalInstituteId").val());
                    var instituteName = $("#EducationalInstituteId option:selected").text().trim();

                    // Validation checks
                    if (!degreeId || degreeId === "") {
                        alert("Please select a Degree Name.");
                        $("#EducationalDegreeId").focus();
                        return;
                    }

                    if (!instituteId || instituteId === "") {
                        alert("Please select an Institute.");
                        $("#EducationalInstituteId").focus();
                        return;
                    }

                    var eduObj = {
                        EducationalDegreeId: degreeId,
                        EducationalDegreeName: degreeName,
                        EducationalInstituteId: instituteId,
                        EducationalInstituteName: instituteName,
                        Board: $.trim($("#Board").val()),
                        PassingYear: $.trim($("#PassingYear").val()),
                        Session: $.trim($("#Session").val()),
                        Result: $.trim($("#Result").val()),
                        Rank: parseInt($("#Rank").val()) || 0
                    };

                    var editIdx = parseInt($("#Edu_Index").val());

                    if (editIdx > -1) {
                        educationList[editIdx] = eduObj;
                    } else {
                        educationList.push(eduObj);
                    }

                    renderEducationTable();
                    clearEduForm();
                });

                // Clear Form Button
                $("#btnClearEduForm").click(function () {
                    clearEduForm();
                });

                // Edit Existing Item
                $(document).on("click", ".btn-edit-edu", function () {
                    var index = $(this).data("index");
                    var item = educationList[index];

                    $("#Edu_Index").val(index);
                    $("#EducationalDegreeId").val(item.EducationalDegreeId);
                    $("#EducationalInstituteId").val(item.EducationalInstituteId);
                    $("#Board").val(item.Board);
                    $("#PassingYear").val(item.PassingYear);
                    $("#Session").val(item.Session);
                    $("#Result").val(item.Result);
                    $("#Rank").val(item.Rank);

                    $("#btnAddEducation").html('<i class="icon-checkmark3 mr-1"></i> Update Entry');
                });

                // Remove Item
                $(document).on("click", ".btn-delete-edu", function () {
                    var index = $(this).data("index");
                    educationList.splice(index, 1);
                    renderEducationTable();
                    clearEduForm();
                });

                function clearEduForm() {
                    $("#Edu_Index").val("-1");
                    $("#EducationalDegreeId").val("");
                    $("#EducationalInstituteId").val("");
                    $("#Board").val("");
                    $("#PassingYear").val("");
                    $("#Session").val("");
                    $("#Result").val("");
                    $("#Rank").val("0");
                    $("#btnAddEducation").html('<i class="icon-plus3 mr-1"></i> Add Entry');
                }

                function renderEducationTable() {
                    var tbody = $("#tblEducation tbody");
                    tbody.empty();

                    if (educationList.length === 0) {
                        tbody.append('<tr id="emptyEduRow"><td colspan="8" class="text-center text-muted">No education details added yet.</td></tr>');
                        $("#educationHiddenInputs").empty();
                        return;
                    }

                    $.each(educationList, function (index, item) {
                        var row = '<tr>' +
                            '<td>' + escapeHtml(item.EducationalDegreeName) + '</td>' +
                            '<td>' + escapeHtml(item.EducationalInstituteName) + '</td>' +
                            '<td>' + (item.Board ? escapeHtml(item.Board) : '-') + '</td>' +
                            '<td>' + (item.PassingYear ? escapeHtml(item.PassingYear) : '-') + '</td>' +
                            '<td>' + (item.Session ? escapeHtml(item.Session) : '-') + '</td>' +
                            '<td>' + (item.Result ? escapeHtml(item.Result) : '-') + '</td>' +
                            '<td>' + item.Rank + '</td>' +
                            '<td class="text-center">' +
                            '<a href="javascript:void(0)" class="btn-edit-edu mr-2 text-primary" data-index="' + index + '" title="Edit"><i class="icon-pencil"></i></a>' +
                            '<a href="javascript:void(0)" class="btn-delete-edu text-danger" data-index="' + index + '" title="Delete"><i class="icon-trash"></i></a>' +
                            '</td>' +
                            '</tr>';
                        tbody.append(row);
                    });

                    syncHiddenEducationInputs();
                }

                // Generates hidden fields with standard MVC list index naming: Educations[i].PropertyName
                function syncHiddenEducationInputs() {
                    var container = $("#educationHiddenInputs");
                    container.empty();

                    $.each(educationList, function (i, item) {
                        container.append('<input type="hidden" name="Educations[' + i + '].EducationalDegreeId" value="' + item.EducationalDegreeId + '" />');
                        container.append('<input type="hidden" name="Educations[' + i + '].EducationalInstituteId" value="' + item.EducationalInstituteId + '" />');
                        container.append('<input type="hidden" name="Educations[' + i + '].Board" value="' + escapeHtml(item.Board) + '" />');
                        container.append('<input type="hidden" name="Educations[' + i + '].PassingYear" value="' + escapeHtml(item.PassingYear) + '" />');
                        container.append('<input type="hidden" name="Educations[' + i + '].Session" value="' + escapeHtml(item.Session) + '" />');
                        container.append('<input type="hidden" name="Educations[' + i + '].Result" value="' + escapeHtml(item.Result) + '" />');
                        container.append('<input type="hidden" name="Educations[' + i + '].Rank" value="' + item.Rank + '" />');
                    });
                }

                function escapeHtml(str) {
                    if (!str) return '';
                    return String(str)
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;");
                }
            });
        // ====================END EDUCATION DYNAMIC ROWS ====================

//  =============================EXPERIENCE DYNAMIC ROWS =====================
          // Pre-populate experience list if loading an existing HrEmployee record

            var trainingList = [];

            $(document).ready(function () {

                // Render table on load if editing an existing employee record
                if (trainingList.length > 0) {
                    renderTrainingTable();
                }

                // Auto-update duration when start or end dates change
                $("#Train_StartDate, #Train_EndDate").on("change", function () {
                    updateTrainingDurationInput();
                });

                function updateTrainingDurationInput() {
                    var startDate = $("#Train_StartDate").val();
                    var endDate = $("#Train_EndDate").val();

                    if (!startDate || !endDate) {
                        $("#Train_Duration").val("");
                        return;
                    }

                    var durationText = calculateTrainingDuration(startDate, endDate);
                    $("#Train_Duration").val(durationText);
                }

                // Add or Update Entry
                $("#btnAddTraining").click(function () {
                    var trainingTitle = $.trim($("#TrainingTitle").val());
                    var trainingSource = $("#TrainingSource").val();
                    var instituteName = $.trim($("#InstituteName").val());
                    var trainer = $.trim($("#Trainer").val());
                    var startDate = $("#Train_StartDate").val();
                    var endDate = $("#Train_EndDate").val();
                    var duration = $.trim($("#Train_Duration").val());

                    // Validations
                    if (!trainingTitle) {
                        alert("Please enter Training Title.");
                        $("#TrainingTitle").focus();
                        return;
                    }

