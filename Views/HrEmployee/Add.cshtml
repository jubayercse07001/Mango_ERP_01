            // 1. Company Change -> Load Divisions
        $("#CompanyId").change(function () {

    var companyId = $(this).val();

    $("#DivisionId").html('<option value="">Loading...</option>');

    $.ajax({

        url: '@Url.Action("GetDivisionByCompany","HrEmployee")',

        type: 'GET',

        data: {
            CompanyId: companyId
        },

        success: function (data) {

            var html = '<option value="">Select Division</option>';

            $.each(data, function (i, item) {

                html += '<option value="' +
                    item.RowId +
                    '">' +
                    item.DivisionName +
                    '</option>';

            });

            $("#DivisionId").html(html);

        }

    });

});

        // 2. Division Change -> Load Branches
        $("#DivisionId").change(function () {

    var companyId = $("#CompanyId").val();
    var divisionId = $(this).val();

    $("#BranchId").html('<option value="">Loading...</option>');

    if (companyId == "" || divisionId == "") {
        $("#BranchId").html('<option value="">Select Branch</option>');
        return;
    }

    $.ajax({

        url: '@Url.Action("GetBranchByCompanyDivision", "HrEmployee")',

        type: 'GET',

        data: {
            CompanyId: companyId,
            DivisionId: divisionId
        },

        success: function (data) {

            var html = '<option value="">Select Branch</option>';

            $.each(data, function (i, item) {

                html += '<option value="' +
                    item.RowId +
                    '">' +
                    item.BranchName +
                    '</option>';

            });

            $("#BranchId").html(html);

        },

        error: function () {

            $("#BranchId").html('<option value="">Failed to load Branch</option>');

        }

    });

});

        // 3. Branch Change -> Load Departments
        $("#BranchId").change(function () {

    var companyId = $("#CompanyId").val();
    var divisionId = $("#DivisionId").val();
    var branchId = $(this).val();

    $("#DepartmentId").html('<option value="">Loading...</option>');

    if (companyId == "" || divisionId == "" || branchId == "") {
        $("#DepartmentId").html('<option value="">Select Department</option>');
        return;
    }

    $.ajax({

        url: '@Url.Action("GetDepartmentByCompanyDivisionBranch", "HrEmployee")',

        type: 'GET',

        data: {
            CompanyId: companyId,
            DivisionId: divisionId,
            BranchId: branchId
        },

        success: function (data) {

            var html = '<option value="">Select Department</option>';

            $.each(data, function (i, item) {

                html += '<option value="' +
                    item.RowId +
                    '">' +
                    item.DepartmentName +
                    '</option>';

            });

            $("#DepartmentId").html(html);

        },

        error: function () {

            $("#DepartmentId").html('<option value="">Failed to load Department</option>');

        }

    });

});

