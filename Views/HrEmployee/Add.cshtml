            //////////////////////////////////////////////////
            // Bind the change event to the permanent checkbox
            $("#IsPermanent").on("change", togglePermanentDate).trigger("change");

            function togglePermanentDate() {
                var isPermanent = $("#IsPermanent").is(":checked");
                var $dateField = $("#DateOfPermanent");

                // Enable if permanent, disable if not
                $dateField.prop("disabled", !isPermanent);

                // If unchecked, clear the date value
                if (!isPermanent) {
                    $dateField.val("");
                } else {
                    // Optional: Re-populate with today's date if they check it and it's empty
                    if (!$dateField.val()) {
                        var today = new Date().toISOString().split('T')[0];
                        $dateField.val(today);
                    }
                }
            }
            /////////
            $("#IsRetired").on("change", toggleRetirementDate).trigger("change");

            function toggleRetirementDate() {
                var isRetired = $("#IsRetired").is(":checked");
                var $dateField = $("#DateOfRetirement");

                // Enable if retired, disable if not
                $dateField.prop("disabled", !isRetired);

                // If unchecked, clear the date value
                if (!isRetired) {
                    $dateField.val("");
                } else {
                    // Optional: Re-populate with today's date if they check it and it's empty
                    if (!$dateField.val()) {
                        var today = new Date().toISOString().split('T')[0];
                        $dateField.val(today);
                    }
                }
            }
