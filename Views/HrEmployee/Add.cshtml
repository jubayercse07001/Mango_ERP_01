                // Helper to format days or months duration
                function calculateTrainingDuration(startDateStr, endDateStr) {
                    var start = new Date(startDateStr);
                    var end = new Date(endDateStr);

                    if (isNaN(start.getTime()) || isNaN(end.getTime())) return '-';

                    var diffTime = end.getTime() - start.getTime();
                    var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1; // Include inclusive start day

                    if (diffDays <= 0) return '-';

                    if (diffDays >= 30) {
                        var months = Math.floor(diffDays / 30);
                        var remainingDays = diffDays % 30;
                        var text = months + (months === 1 ? " mo " : " mos ");
                        if (remainingDays > 0) text += remainingDays + (remainingDays === 1 ? " day" : " days");
                        return text.trim();
                    }

                    return diffDays + (diffDays === 1 ? " day" : " days");
                }

