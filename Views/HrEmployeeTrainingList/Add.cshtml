@using ERP.Models.HR.Employee.HrEmployeeTrainingList

@{
    ViewBag.Title = "Add Training List Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index","Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <a href="@Url.Action("Index","HrEmployeeTrainingList")" class="breadcrumb-item">
                    HrEmployeeTrainingList
                </a>
                <span class="breadcrumb-item active">Add</span>
            </div>
        </div>
    </div>

</div>

<div class="content">

    <form id="my-form">
        <div class="card" id="maindiv">
            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Add New Training List Item</h6>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">

                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span> Training Category
                            </label>
                            <div class="col-lg-8">
                                <select name="TrainingCategoryId" id="TrainingCategoryId" class="form-control">
                                    <option value="">Select Category</option>
                                    @if (ViewBag.TrainingCategoryList != null)
                                    {
                                        foreach (var item in ViewBag.TrainingCategoryList)
                                        {
                                            <option value="@item.RowId">
                                                @item.TrainingCategoryName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span> Training Title
                            </label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="TrainingTitle"
                                       id="TrainingTitle"
                                       class="form-control"
                                       placeholder="Training Title" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Description</label>
                            <div class="col-lg-8">
                                <textarea name="Description"
                                          id="Description"
                                          rows="4"
                                          class="form-control"
                                          placeholder="Enter training details or syllabus specifications..."></textarea>
                            </div>
                        </div>

                    </div>

                    <div class="col-md-6"></div>
                </div>
            </div>

            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage"></div>
                </div>
            </div>

            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <button type="button" id="btnSubmit" class="btn bg-blue">
                        Submit <i class="icon-paperplane ml-2"></i>
                    </button>
                    <a href="@Url.Action("Index","HrEmployeeTrainingList")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>
        </div>

        <div class="card" id="successdiv" style="display:none">
            <div class="card-header bg-white">
                <h6 class="card-title">Item Added Successfully</h6>
            </div>
            <div class="card-body">
                <h4 class="text-success">
                    Training list identification details have been stored successfully.
                </h4>
            </div>
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Add","HrEmployeeTrainingList")" class="btn btn-light">
                        Add Another
                    </a>
                    <a href="@Url.Action("Index","HrEmployeeTrainingList")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>
        </div>
    </form>

</div>

@section ChildpageJavaScript
{
    <script>
        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                // Clear any previous error layouts
                $("#errormessage").html("");
                $("#errordiv").hide();

                // Simple Client-side Form Validation
                var categoryId = $("#TrainingCategoryId").val();
                var title = $("#TrainingTitle").val().trim();

                var clientErrors = [];
                if (!categoryId) {
                    clientErrors.push("Training Category is required");
                }
                if (!title) {
                    clientErrors.push("Training Title is required");
                }

                if (clientErrors.length > 0) {
                    var errorHtml = "<ul>";
                    $.each(clientErrors, function (index, value) {
                        errorHtml += "<li>" + value + "</li>";
                    });
                    errorHtml += "</ul>";

                    $("#errormessage").html(errorHtml);
                    $("#errordiv").show();
                    return;
                }

                // Execute data pipeline post
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Add", "HrEmployeeTrainingList")',
                    data: $("#my-form").serialize(),
                    success: function (data) {
                        if (data.ResponseStatus == -1) {
                            window.location.href = '@Url.Action("Logout","Login")';
                        }
                        else if (data.ResponseStatus == -2) {
                            window.location.href = '@Url.Action("Index","HrEmployeeTrainingList")';
                        }
                        else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#errordiv").show();
                        }
                        else {
                            $("#errordiv").hide();
                            $("#maindiv").hide();
                            $("#successdiv").show();
                        }
                    },
                    error: function () {
                        $("#errormessage").html("An unexpected network transmission error occurred.");
                        $("#errordiv").show();
                    }
                });
            });

        });
    </script>
}