@using ERP.Models.HR.Employee.HrEmployeeTrainingList;

@{
    ViewBag.Title = "Edit Training List Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
    <div class="d-flex">
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                <i class="icon-home2 mr-2"></i> Home
            </a>
            <a href="@Url.Action("Index", "HrEmployeeTrainingList")" class="breadcrumb-item">
                HrEmployeeTrainingList
            </a>
            <span class="breadcrumb-item active">Edit</span>
        </div>
    </div>
</div>

<form id="my-form">

    <div class="card" id="maindiv">

        <div class="card-header bg-white header-elements-inline">
            <h6 class="card-title">Edit Existing Training List Item</h6>

            <input type="hidden"
                   name="RowId"
                   value="@ViewBag.HrEmployeeTrainingList.RowId" />
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6">

                    <div class="form-group row">
                        <label class="col-lg-4 col-form-label">
                            <span class="text-danger">*</span> Training Category
                        </label>
                        <div class="col-lg-8">
                            <select name="TrainingCategoryId" id="TrainingCategoryId" class="form-control">
                                <option value="">Select Category</option>
                                @foreach (var item in ViewBag.TrainingCategoryList)
                                {
                                    <option value="@item.RowId"
                                            @(item.RowId == ViewBag.HrEmployeeTrainingList.TrainingCategoryId ? "selected" : "")>
                                        @item.TrainingCategoryName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-lg-4 col-form-label">
                            <span class="text-danger">*</span> Training Title
                        </label>
                        <div class="col-lg-8">
                            <input type="text"
                                   name="TrainingTitle"
                                   id="TrainingTitle"
                                   class="form-control"
                                   value="@ViewBag.HrEmployeeTrainingList.TrainingTitle"
                                   placeholder="Training Title" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-lg-4 col-form-label">Description</label>
                        <div class="col-lg-8">
                            <textarea name="Description"
                                      id="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Description">@ViewBag.HrEmployeeTrainingList.Description</textarea>
                        </div>
                    </div>

                </div>

                <div class="col-md-6"></div>

            </div>
        </div>

        <div class="card-footer bg-white" id="errordiv" style="display:none">
            <div class="row">
                <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage"></div>
            </div>
        </div>

        <div class="card-footer bg-white" id="successdiv" style="display:none">
            <div class="row">
                <div class="col-lg-10 ml-lg-auto text-success">
                    <h2>Training information has been updated successfully.</h2>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white">
            <div class="row">
                <div class="col-lg-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" id="btnSubmit" class="btn bg-blue">
                            Submit <i class="icon-paperplane ml-2"></i>
                        </button>
                        <a href="@Url.Action("Index","HrEmployeeTrainingList")" class="btn btn-light">
                            Back To List
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</form>

@section ChildpageJavaScript{

    <script>
        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                var formData = new FormData($('#my-form')[0]);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Edit", "HrEmployeeTrainingList")',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href = '@Url.Action("Logout", "Login")';
                        }
                        else if (data.ResponseStatus == -2) {
                            window.location.href = '@Url.Action("Index", "HrEmployeeTrainingList")';
                        }
                        else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#successdiv").hide();
                            $("#errordiv").show();
                        }
                        else {
                            $("#errormessage").html("");
                            $("#errordiv").hide();
                            $("#successdiv").show();
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                        $("#errormessage").html(xhr.responseText);
                        $("#successdiv").hide();
                        $("#errordiv").show();
                    }
                });
            });
        });
    </script>
}