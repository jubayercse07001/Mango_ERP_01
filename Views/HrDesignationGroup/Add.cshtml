@using ERP.Models.HR.Organization.HrDesignationGroup;
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="page-header page-header-light ">


    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
                <a href="@Url.Action("Index", "HrDesignationGroup")" class="breadcrumb-item">HrDesignationGroup</a>  <span class="breadcrumb-item active">Add</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>


    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <!-- Individual column searching (text inputs) -->


    <form action="#" id="my-form">
        <div class="card" id="maindiv">
            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Add New HrDesignationGroup</h6>

            </div>

            <div class="card-body">

                
                <div class="form-group row ">
                    <label class="col-form-label col-lg-2">
                        <span class="text-danger">*</span>Designation Group:
                    </label>
                    <div class="col-lg-2">
                        <input type="text" name="DesignationGroup" class="form-control" placeholder="Designation Group" value="">
                    </div>
                </div>
                <div class="form-group row ">
                    <label class="col-form-label col-lg-2">
                        <span class="text-danger">*</span>Rank:
                    </label>
                    <div class="col-lg-2">
                        <input type="number" name="Rank" class="form-control" placeholder="Rank" value="0">
                    </div>
                </div>


            </div>
            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage">
                        there
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" id="btnSubmit" class="btn bg-blue ml-3">Submit <i class="icon-paperplane ml-2"></i></button>
                            <button type="button" class="btn btn-light"> <a href="@Url.Action("Index", "HrDesignationGroup")">Back to List</a></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="display:none" id="successdiv">
            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Add New DesignationGroup</h6>

            </div>

            <div class="card-body">
                <div class="form-group row">

                    <div class="col-lg-12 color-selector-active text-success">
                        <h2>DesignationGroup has been added successfully. </h2>
                    </div>
                </div>

            </div>

            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-12 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" class="btn btn-light"> <a href="@Url.Action("Add", "HrDesignationGroup")">Add Another</a></button>
                            <button type="button" class="btn btn-light"> <a href="@Url.Action("Index", "HrDesignationGroup")">Back to List</a></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- /individual column searching (text inputs) -->



</div>
<!-- /content area -->


@section ChildpageJavaScript{
    <script>

        $(document).ready(function () {
        $("#btnSubmit").click(function () {
            $.ajax(
            {
                type: "POST",
                url:  "@Url.Action("Add", "HrDesignationGroup")",
                data: $("#my-form").serialize(),
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href =  "@Url.Action("Logout", "Login")";
                        } else if (data.ResponseStatus == -2) {
                            window.location.href =  "@Url.Action("Index", "HrDesignationGroup")";
                        } else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#errordiv").show();
                        }
                        else {
                            $("#errormessage").html("");
                            $("#errordiv").hide();
                            $("#maindiv").hide();
                            $("#successdiv").show();
                            }

                    }
                });
            });
    });

        const rankInput = document.querySelector('input[name="Rank"]');

        // Remove 0 when user focuses
        rankInput.addEventListener('focus', function () {
            if (this.value === "0") {
                this.value = "";
            }
        });

        // If left empty, restore 0
        rankInput.addEventListener('blur', function () {
            if (this.value === "") {
                this.value = "0";
            }
        });

    </script>
}