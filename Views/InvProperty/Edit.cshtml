@using ERP.Models.Inventory.InvProperty

@{
    ViewBag.Title = "Edit Property";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index","Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i>
                    Home
                </a>

                <a href="@Url.Action("Index","InvProperty")"
                   class="breadcrumb-item">
                    InvProperty
                </a>

                <span class="breadcrumb-item active">
                    Edit
                </span>

            </div>

        </div>

    </div>

</div>

<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Edit Existing Property
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.InvProperty.RowId" />

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <!-- Property Group -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Property Group
                            </label>

                            <div class="col-lg-8">

                                <select name="GroupId"
                                        id="GroupId"
                                        class="form-control">

                                    <option value="">
                                        Select Group
                                    </option>

                                    @if (ViewBag.GroupList != null)
                                    {
                                        foreach (var item in ViewBag.GroupList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId == ViewBag.InvProperty.GroupId ? "selected" : "")>
                                                @item.GroupName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>

                        <!-- Property Name -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Property Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="PropertyName"
                                       id="PropertyName"
                                       class="form-control"
                                       value="@ViewBag.InvProperty.PropertyName"
                                       placeholder="Property Name" />

                            </div>

                        </div>

                        <!-- Property Description -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Property Description
                            </label>

                            <div class="col-lg-8">

                                <textarea name="PropertyDescription"
                                          id="PropertyDescription"
                                          rows="3"
                                          class="form-control"
                                          placeholder="Property Description">@ViewBag.InvProperty.PropertyDescription</textarea>

                            </div>

                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>

            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h4>
                            Property information has been updated successfully.
                        </h4>

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <button type="button"
                            id="btnSubmit"
                            class="btn bg-blue">

                        Submit
                        <i class="icon-paperplane ml-2"></i>

                    </button>

                    <a href="@Url.Action("Index","InvProperty")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript
{
    <script>

$(document).ready(function () {

    $("#btnSubmit").click(function () {

        var formData = new FormData($('#my-form')[0]);

        $.ajax({

            type: "POST",

            url: '@Url.Action("Edit", "InvProperty")',

            data: formData,

            processData: false,
            contentType: false,

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout","Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index","InvProperty")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(
                        data.ResponseMessage
                    );

                    $("#successdiv").hide();
                    $("#errordiv").show();

                }
                else {

                    $("#errormessage").html("");

                    $("#errordiv").hide();
                    $("#successdiv").show();

                }

            },

            error: function (xhr) {

                $("#errormessage").html(
                    xhr.responseText
                );

                $("#successdiv").hide();
                $("#errordiv").show();

            }

        });

    });

});

    </script>
}