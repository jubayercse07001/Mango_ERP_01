@using ERP.Models.HR.Employee.HrEmployeeTrainingCategory;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Training Category";
}

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index", "HrEmployeeTrainingCategory")" class="breadcrumb-item">
                    HrEmployeeTrainingCategory
                </a>

                <span class="breadcrumb-item active">
                    Delete
                </span>

            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>

        </div>
    </div>

</div>

<div class="content">

    <form action="#" id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Delete Existing Training Category
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.HrTrainingCategory.RowId" />

            </div>

            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-danger">
                        <h2>
                            Are you sure you want to delete the following Training Category?
                        </h2>
                    </div>
                </div>
            </div>

            <div class="card-body">

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3">
                        Training Category ID:
                    </label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrTrainingCategory.TrainingCategoryId
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3">
                        Training Category Name:
                    </label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.HrTrainingCategory.TrainingCategoryName
                    </div>
                </div>

            </div>

            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage">
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white" id="successdiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-success">
                        <h2>
                            Training Category has been deleted successfully.
                        </h2>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">

                            <button type="button" id="btnSubmit" class="btn bg-danger ml-3">
                                Delete <i class="icon-cross ml-2"></i>
                            </button>

                            <a href="@Url.Action("Index", "HrEmployeeTrainingCategory")" class="btn btn-light">
                                Back to List
                            </a>

                        </div>
                    </div>
                </div>
            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript{

    <script>
        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Delete", "HrEmployeeTrainingCategory")',
                    data: $("#my-form").serialize(),
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href = '@Url.Action("Logout", "Login")';
                        }
                        else if (data.ResponseStatus == -2) {
                            window.location.href = '@Url.Action("Index", "HrEmployeeTrainingCategory")';
                        }
                        else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#successdiv").hide();
                            $("#errordiv").show();
                        }
                        else {
                            $("#errormessage").html("");
                            $("#errordiv").hide();
                            $("#btnSubmit").hide();
                            $("#successdiv").show();
                        }
                    }
                });

            });

        });
    </script>

}