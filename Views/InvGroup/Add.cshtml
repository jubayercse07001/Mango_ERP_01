@using ERP.Models.Inventory.InvGroup

@{
    ViewBag.Title = "Add Inventory Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index","Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i>
                    Home

                </a>

                <a href="@Url.Action("Index","InvGroup")"
                   class="breadcrumb-item">

                    Inventory Group

                </a>

                <span class="breadcrumb-item active">
                    Add
                </span>

            </div>

        </div>

    </div>

</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Add New Inventory Group
                </h6>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <!-- Group Name -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Group Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="GroupName"
                                       id="GroupName"
                                       class="form-control"
                                       placeholder="Group Name" />

                            </div>

                        </div>

                        <!-- Group Description -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Group Description
                            </label>

                            <div class="col-lg-8">

                                <textarea name="GroupDescription"
                                          id="GroupDescription"
                                          rows="3"
                                          class="form-control"
                                          placeholder="Group Description"></textarea>

                            </div>

                        </div>

                        <!-- Rank -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                Rank
                            </label>
                            <div class="col-lg-8">
                                <input type="number"
                                       id="Rank"
                                       name="Rank"
                                       class="form-control"
                                       value="1"
                                       readonly="readonly"
                                       placeholder="Rank" />
                            </div>
                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <button type="button"
                            id="btnSubmit"
                            class="btn bg-blue">

                        Submit
                        <i class="icon-paperplane ml-2"></i>

                    </button>

                    <a href="@Url.Action("Index","InvGroup")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

        <div class="card"
             id="successdiv"
             style="display:none">

            <div class="card-header bg-white">

                <h6 class="card-title">
                    Inventory Group Added Successfully
                </h6>

            </div>

            <div class="card-body">

                <h4 class="text-success">
                    Inventory group information has been added successfully.
                </h4>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <a href="@Url.Action("Add","InvGroup")"
                       class="btn btn-light">

                        Add Another

                    </a>

                    <a href="@Url.Action("Index","InvGroup")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript
{

    <script>

        $(document).ready(function () {
    function updateRank() {
    $.ajax({
        url: '@Url.Action("GetNextRank", "InvGroup")',
        type: 'GET',
        cache: false,
        success: function (rankValue) {
            $("#Rank").val(rankValue);
        },
        error: function () {
            $("#Rank").val(1); // fallback default
        }
    });
}

// Call on DOM ready to auto-populate upon opening the form
$(document).ready(function () {
    updateRank();
});

    $("#btnSubmit").click(function () {

        $.ajax({

            type: "POST",

            url: '@Url.Action("Add", "InvGroup")',

            data: $("#my-form").serialize(),

            success: function (data) {

                if (data.ResponseStatus == -1) {

                    window.location.href =
                        '@Url.Action("Logout","Login")';

                }
                else if (data.ResponseStatus == -2) {

                    window.location.href =
                        '@Url.Action("Index","InvGroup")';

                }
                else if (data.ResponseStatus == 0) {

                    $("#errormessage").html(
                        data.ResponseMessage
                    );

                    $("#errordiv").show();

                }
                else {

                    $("#errordiv").hide();

                    $("#maindiv").hide();

                    $("#successdiv").show();

                }

            }

        });

    });

});

    </script>

}