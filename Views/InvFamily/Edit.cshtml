@using ERP.Models.Inventory.InvFamily

@{
    ViewBag.Title = "Edit Inventory Family";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index","Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i>
                    Home
                </a>

                <a href="@Url.Action("Index","InvFamily")"
                   class="breadcrumb-item">
                    Inventory Family
                </a>

                <span class="breadcrumb-item active">
                    Edit
                </span>

            </div>

        </div>

    </div>

</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Edit Existing Inventory Family
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.InvFamily.RowId" />

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <!-- Class Dropdown -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Class
                            </label>

                            <div class="col-lg-8">

                                <select name="ClassId"
                                        id="ClassId"
                                        class="form-control">

                                    <option value="">
                                        Select Class
                                    </option>

                                    @if (ViewBag.ClassList != null)
                                    {
                                        foreach (var item in ViewBag.ClassList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId == ViewBag.InvFamily.ClassId ? "selected" : "")>
                                                @item.ClassName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>

                        <!-- Family Name -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Family Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="FamilyName"
                                       id="FamilyName"
                                       class="form-control"
                                       value="@ViewBag.InvFamily.FamilyName"
                                       placeholder="Family Name" />

                            </div>

                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>

            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h4>
                            Inventory Family information has been updated successfully.
                        </h4>

                    </div>

                </div>

            </div>

            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <button type="button"
                            id="btnSubmit"
                            class="btn bg-blue">

                        Submit
                        <i class="icon-paperplane ml-2"></i>

                    </button>

                    <a href="@Url.Action("Index","InvFamily")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript
{
    <script>

    $(document).ready(function () {

        $("#btnSubmit").click(function () {

            var formData = new FormData($('#my-form')[0]);

            $.ajax({

                type: "POST",

                url: '@Url.Action("Edit", "InvFamily")',

                data: formData,

                processData: false,
                contentType: false,

                success: function (data) {

                    if (data.ResponseStatus == -1) {

                        window.location.href =
                            '@Url.Action("Logout","Login")';

                    }
                    else if (data.ResponseStatus == -2) {

                        window.location.href =
                            '@Url.Action("Index","InvFamily")';

                    }
                    else if (data.ResponseStatus == 0) {

                        $("#errormessage").html(
                            data.ResponseMessage
                        );

                        $("#successdiv").hide();
                        $("#errordiv").show();

                    }
                    else {

                        $("#errormessage").html("");

                        $("#errordiv").hide();
                        $("#successdiv").show();

                    }

                },

                error: function (xhr) {

                    $("#errormessage").html(
                        xhr.responseText
                    );

                    $("#successdiv").hide();
                    $("#errordiv").show();

                }

            });

        });

    });

    </script>
}