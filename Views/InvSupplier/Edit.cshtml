@using ERP.Models.Inventory.InvSupplier

@{
    ViewBag.Title = "Edit Supplier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index","Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <a href="@Url.Action("Index","InvSupplier")" class="breadcrumb-item">
                    InvSupplier
                </a>
                <span class="breadcrumb-item active">Edit</span>
            </div>
        </div>
    </div>
</div>
<!-- /Page Header -->

<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Edit Existing Supplier</h6>

                <!-- Hidden Primary Keys / Identifiers -->
                <input type="hidden" name="RowId" value="@ViewBag.InvSupplier.RowId" />
                <input type="hidden" name="SupplierId" value="@ViewBag.InvSupplier.SupplierId" />
            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <!-- Supplier Name -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span> Supplier Name
                            </label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="SupplierName"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.SupplierName"
                                       placeholder="Supplier Name" />
                            </div>
                        </div>

                        <!-- Contact Person -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Contact Person</label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="ContactPerson"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.ContactPerson"
                                       placeholder="Contact Person Name" />
                            </div>
                        </div>

                        <!-- Contact Designation -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Contact Designation</label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="ContactDesignation"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.ContactDesignation"
                                       placeholder="Designation" />
                            </div>
                        </div>

                        <!-- Office Phone -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Office Phone</label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="OfficePhone"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.OfficePhone"
                                       placeholder="Office Phone Number" />
                            </div>
                        </div>

                        <!-- Mobile -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Mobile</label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="Mobile"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.Mobile"
                                       placeholder="Mobile Number" />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Email</label>
                            <div class="col-lg-8">
                                <input type="email"
                                       name="Email"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.Email"
                                       placeholder="Email Address" />
                            </div>
                        </div>

                        <!-- Website -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Website</label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="Web"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.Web"
                                       placeholder="Website URL" />
                            </div>
                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                        <!-- Country Dropdown -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Country</label>
                            <div class="col-lg-8">
                                <select name="CountryId" id="CountryId" class="form-control">
                                    <option value="">Select Country</option>
                                    @if (ViewBag.CountryList != null)
                                    {
                                        foreach (var item in ViewBag.CountryList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId == ViewBag.InvSupplier.CountryId ? "selected" : "")>
                                                @item.CountryName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Foreign Supplier Toggle -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Foreign Supplier?</label>
                            <div class="col-lg-8">
                                <select name="IsForeignSupplier" id="IsForeignSupplier" class="form-control">
                                    <option value="0" @(ViewBag.InvSupplier.IsForeignSupplier == 0 ? "selected" : "")>No (Local)</option>
                                    <option value="1" @(ViewBag.InvSupplier.IsForeignSupplier == 1 ? "selected" : "")>Yes (Foreign)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Commission Percent -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Commission (%)</label>
                            <div class="col-lg-8">
                                <input type="number"
                                       step="0.01"
                                       name="ComissionPercent"
                                       class="form-control"
                                       value="@ViewBag.InvSupplier.ComissionPercent"
                                       placeholder="0.00" />
                            </div>
                        </div>

                        <!-- Department Dropdown -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Department</label>
                            <div class="col-lg-8">
                                <select name="DepartmentId" id="DepartmentId" class="form-control">
                                    <option value="">Select Department</option>
                                    @if (ViewBag.DepartmentList != null)
                                    {
                                        foreach (var item in ViewBag.DepartmentList)
                                        {
                                            <option value="@item.RowId"
                                                    @(item.RowId == ViewBag.InvSupplier.DepartmentId ? "selected" : "")>
                                                @item.DepartmentName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Mailing Address -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Mailing Address</label>
                            <div class="col-lg-8">
                                <textarea name="MailingAddress"
                                          class="form-control"
                                          rows="2"
                                          placeholder="Mailing Address">@ViewBag.InvSupplier.MailingAddress</textarea>
                            </div>
                        </div>

                        <!-- Billing Address -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Billing Address</label>
                            <div class="col-lg-8">
                                <textarea name="BillingAddress"
                                          class="form-control"
                                          rows="2"
                                          placeholder="Billing Address">@ViewBag.InvSupplier.BillingAddress</textarea>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Error Message Panel -->
            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage"></div>
                </div>
            </div>

            <!-- Inline Success Notification Panel -->
            <div class="card-footer bg-white" id="successdiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-success">
                        <h4>Supplier information has been updated successfully.</h4>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <button type="button" id="btnSubmit" class="btn bg-blue">
                        Submit <i class="icon-paperplane ml-2"></i>
                    </button>
                    <a href="@Url.Action("Index","InvSupplier")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript
{
    <script>
        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                var formData = new FormData($('#my-form')[0]);

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Edit", "InvSupplier")',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href = '@Url.Action("Logout","Login")';
                        }
                        else if (data.ResponseStatus == -2) {
                            window.location.href = '@Url.Action("Index","InvSupplier")';
                        }
                        else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#successdiv").hide();
                            $("#errordiv").show();
                        }
                        else {
                            $("#errormessage").html("");
                            $("#errordiv").hide();
                            $("#successdiv").show();
                        }

                    },
                    error: function (xhr) {
                        $("#errormessage").html(xhr.responseText);
                        $("#successdiv").hide();
                        $("#errordiv").show();
                    }
                });

            });

        });
    </script>
}