@using ERP.Models.Inventory.InvSupplier

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Supplier";
}

<!-- Page Header -->
<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <a href="@Url.Action("Index", "InvSupplier")" class="breadcrumb-item">
                    InvSupplier
                </a>
                <span class="breadcrumb-item active">Delete</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>
        </div>
    </div>
</div>
<!-- /Page Header -->
<!-- Content Area -->
<div class="content">

    <form action="#" id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Delete Existing Supplier</h6>

                <input type="hidden" name="RowId" value="@ViewBag.InvSupplier.RowId" />
                <input type="hidden" name="SupplierId" value="@ViewBag.InvSupplier.SupplierId" />
            </div>

            <!-- Warning Confirmation -->
            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-danger">
                        <h2>Are you sure you want to delete the following Supplier?</h2>
                    </div>
                </div>
            </div>

            <!-- Read-Only Record Details -->
            <div class="card-body">

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Supplier Name:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.SupplierName
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Contact Person:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.ContactPerson (@ViewBag.InvSupplier.ContactDesignation)
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Office Phone / Mobile:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.OfficePhone / @ViewBag.InvSupplier.Mobile
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Email / Website:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.Email | @ViewBag.InvSupplier.Web
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Country:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.CountryName
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Supplier Type:</label>
                    <div class="col-lg-9 pt-2">
                        @(ViewBag.InvSupplier.IsForeignSupplier == 1 ? "Foreign Supplier" : "Local Supplier")
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Commission (%):</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.ComissionPercent%
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Mailing Address:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.MailingAddress
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-3 font-weight-semibold">Billing Address:</label>
                    <div class="col-lg-9 pt-2">
                        @ViewBag.InvSupplier.BillingAddress
                    </div>
                </div>

            </div>

            <!-- Error Notification Div -->
            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage"></div>
                </div>
            </div>

            <!-- Success Notification Div -->
            <div class="card-footer bg-white" id="successdiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-success">
                        <h2>Supplier has been deleted successfully.</h2>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" id="btnSubmit" class="btn bg-danger ml-3">
                                Delete <i class="icon-cross ml-2"></i>
                            </button>

                            <a href="@Url.Action("Index", "InvSupplier")" class="btn btn-light">
                                Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript
{
    <script>
        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Delete", "InvSupplier")',
                    data: $("#my-form").serialize(),
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href = '@Url.Action("Logout", "Login")';
                        }
                        else if (data.ResponseStatus == -2) {
                            window.location.href = '@Url.Action("Index", "InvSupplier")';
                        }
                        else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#successdiv").hide();
                            $("#errordiv").show();
                        }
                        else {
                            $("#errormessage").html("");
                            $("#errordiv").hide();
                            $("#btnSubmit").hide();
                            $("#successdiv").show();
                        }
                    }
                });

            });

        });
    </script>
}