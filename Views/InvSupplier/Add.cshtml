@using ERP.Models.Inventory.InvSupplier

@{
    ViewBag.Title = "Add Supplier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index","Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <a href="@Url.Action("Index","InvSupplier")" class="breadcrumb-item">
                    InvSupplier
                </a>
                <span class="breadcrumb-item active">Add</span>
            </div>
        </div>
    </div>
</div>
<!-- /Page Header -->

<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Add New Supplier</h6>
            </div>

            <div class="card-body">

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <!-- Supplier Name -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span> Supplier Name
                            </label>
                            <div class="col-lg-8">
                                <input type="text" name="SupplierName" class="form-control" placeholder="Supplier Name" required />
                            </div>
                        </div>

                        <!-- Contact Person -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Contact Person</label>
                            <div class="col-lg-8">
                                <input type="text" name="ContactPerson" class="form-control" placeholder="Contact Person Name" />
                            </div>
                        </div>

                        <!-- Contact Designation -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Contact Designation</label>
                            <div class="col-lg-8">
                                <input type="text" name="ContactDesignation" class="form-control" placeholder="Designation" />
                            </div>
                        </div>

                        <!-- Office Phone -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Office Phone</label>
                            <div class="col-lg-8">
                                <input type="text" name="OfficePhone" class="form-control" placeholder="Office Phone Number" />
                            </div>
                        </div>

                        <!-- Mobile -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Mobile</label>
                            <div class="col-lg-8">
                                <input type="text" name="Mobile" class="form-control" placeholder="Mobile Number" />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Email</label>
                            <div class="col-lg-8">
                                <input type="email" name="Email" class="form-control" placeholder="Email Address" />
                            </div>
                        </div>

                        <!-- Website -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Website</label>
                            <div class="col-lg-8">
                                <input type="text" name="Web" class="form-control" placeholder="Website URL" />
                            </div>
                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                        <!-- Country Dropdown -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Country</label>
                            <div class="col-lg-8">
                                <select name="CountryId" id="CountryId" class="form-control">
                                    <option value="">Select Country</option>
                                    @if (ViewBag.CountryList != null)
                                    {
                                        foreach (var item in ViewBag.CountryList)
                                        {
                                            <option value="@item.RowId">@item.CountryName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Foreign Supplier Toggle -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Foreign Supplier?</label>
                            <div class="col-lg-8 d-flex align-items-center">
                                <div class="form-check form-check-switchery">
                                    <label class="form-check-label">
                                        <input type="checkbox" id="IsForeignSupplier" class="form-check-input-styled" checked />
                                        <input type="hidden" name="IsForeignSupplier" id="IsForeignSupplier" value="1" />
                                        Is Foreign Supplier
                                    </label>
                                </div>
                            </div>
                        </div>
                        

                        <!-- Commission Percent -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Commission (%)</label>
                            <div class="col-lg-8">
                                <input type="number" step="0.01" name="ComissionPercent" class="form-control" placeholder="0.00" value="0" />
                            </div>
                        </div>

                        <!-- Department Dropdown -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Department</label>
                            <div class="col-lg-8">
                                <select name="DepartmentId" id="DepartmentId" class="form-control">
                                    <option value="">Select Department</option>
                                    @if (ViewBag.DepartmentList != null)
                                    {
                                        foreach (var item in ViewBag.DepartmentList)
                                        {
                                            <option value="@item.RowId">@item.DepartmentName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Mailing Address -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Mailing Address</label>
                            <div class="col-lg-8">
                                <textarea name="MailingAddress" class="form-control" rows="2" placeholder="Mailing Address"></textarea>
                            </div>
                        </div>

                        <!-- Billing Address -->
                        <div class="form-group row">
                            <label class="col-lg-4 col-form-label">Billing Address</label>
                            <div class="col-lg-8">
                                <textarea name="BillingAddress" class="form-control" rows="2" placeholder="Billing Address"></textarea>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Error Message Panel -->
            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage"></div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <button type="button" id="btnSubmit" class="btn bg-blue">
                        Submit <i class="icon-paperplane ml-2"></i>
                    </button>
                    <a href="@Url.Action("Index","InvSupplier")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>

        </div>

        <!-- Success Panel -->
        <div class="card" id="successdiv" style="display:none">
            <div class="card-header bg-white">
                <h6 class="card-title">Supplier Added Successfully</h6>
            </div>
            <div class="card-body">
                <h4 class="text-success">
                    Supplier information has been added successfully.
                </h4>
            </div>
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Add","InvSupplier")" class="btn btn-light">
                        Add Another
                    </a>
                    <a href="@Url.Action("Index","InvSupplier")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>
        </div>

    </form>

</div>

@section ChildpageJavaScript
{
    <script>
        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Add", "InvSupplier")',
                    data: $("#my-form").serialize(),
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href = '@Url.Action("Logout","Login")';
                        }
                        else if (data.ResponseStatus == -2) {
                            window.location.href = '@Url.Action("Index","InvSupplier")';
                        }
                        else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#errordiv").show();
                        }
                        else {
                            $("#errordiv").hide();
                            $("#maindiv").hide();
                            $("#successdiv").show();
                        }

                    }
                });

            });

        });
    </script>
}