@using ERP.Models.Inventory.InvDepartmentRequisition

@{ ViewBag.Title = "Department Requisition";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i> Home

                </a>

                <span class="breadcrumb-item">
                    Inventory
                </span>

                <span class="breadcrumb-item active">
                    Department Requisition
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">

                <i class="icon-more"></i>

            </a>

        </div>

        <div class="header-elements d-none">

            <div class="breadcrumb justify-content-center">
            </div>

        </div>

    </div>

</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <div class="card">

        <!-- Card header -->
        <div class="card-header header-elements-inline">

            <h5 class="card-title">
                List of Department Requisitions
            </h5>

            <div class="header-elements">

                <!-- Advance Search -->
                <a href="javascript:$('#my-form').toggle();">

                    <button type="button"
                            class="btn btn-light mr-3 text-success">

                        <i class="icon-search4 mr-2"></i>
                        Advance Search

                    </button>

                </a>


                <!-- Reset Search -->
                <a href="javascript:ResetSearch();">

                    <button type="button"
                            class="btn btn-light mr-3 text-danger-300">

                        <i class="icon-reset mr-2"></i>
                        Reset Search

                    </button>

                </a>


                <!-- Add New -->
                <button type="button"
                        class="btn btn-light">

                    <a href="@Url.Action("Add", "InvDepartmentRequisition2nd")">

                        <i class="icon-add mr-2"></i>
                        Add New

                    </a>

                </button>

            </div>

        </div>
        <!-- /card header -->
        <!-- Search Form -->
        <form id="my-form"
              style="display:none">

            <div class="card-body">

                <div class="row">

                    <!-- Requisition Code -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Requisition Code
                            </label>

                            <input type="text"
                                   name="RequisitionCode"
                                   id="RequisitionCode"
                                   class="form-control"
                                   placeholder="Requisition Code" />

                        </div>

                    </div>


                    <!-- Requisition Name -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Requisition Name
                            </label>

                            <input type="text"
                                   name="RequisitionName"
                                   id="RequisitionName"
                                   class="form-control"
                                   placeholder="Requisition Name" />

                        </div>

                    </div>


                    <!-- Department -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Department
                            </label>

                            <select name="DepartmentId"
                                    id="DepartmentId"
                                    class="form-control">

                                <option value="">
                                    -- Select Department --
                                </option>

                                @if (ViewBag.DepartmentList != null)
                                {
                                    foreach (var item in ViewBag.DepartmentList)
                                    {
                                        <option value="@item.RowId">
                                            @item.DepartmentName
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                    </div>


                    <!-- Job No -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Job No
                            </label>

                            <input type="text"
                                   name="JobNo"
                                   id="JobNo"
                                   class="form-control"
                                   placeholder="Job No" />

                        </div>

                    </div>


                    <!-- Approval Status -->
                    <div class="col-lg-4">

                        <div class="form-group">

                            <label>
                                Approval Status
                            </label>

                            <select name="ApprovalStatus"
                                    id="ApprovalStatus"
                                    class="form-control">

                                <option value="All">
                                    All
                                </option>

                                <option value="Approved">
                                    Approved
                                </option>

                                <option value="Pending">
                                    Pending
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- From Date -->
                    <div class="col-lg-2">

                        <div class="form-group">

                            <label>
                                From Date
                            </label>

                            <input type="date"
                                   name="FromDate"
                                   id="FromDate"
                                   class="form-control" />

                        </div>

                    </div>


                    <!-- To Date -->
                    <div class="col-lg-2">

                        <div class="form-group">

                            <label>
                                To Date
                            </label>

                            <input type="date"
                                   name="ToDate"
                                   id="ToDate"
                                   class="form-control" />

                        </div>

                    </div>

                </div>

            </div>


            <!-- Search Footer -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-12">

                        <div class="d-flex justify-content-between align-items-center">

                            <!-- Close -->
                            <button type="button"
                                    class="btn btn-light text-brown-300"
                                    onclick="$('#my-form').hide();">

                                Close Search Panel

                            </button>


                            <div>

                                <!-- Reset -->
                                <button type="button"
                                        class="btn btn-light text-danger-300 mr-2"
                                        onclick="ResetSearch();">

                                    <i class="icon-reset mr-2"></i>
                                    Reset Search

                                </button>


                                <!-- Search -->
                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="ReloadDataTable();">

                                    <i class="icon-search4 mr-2"></i>
                                    Search

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <hr />

        </form>
        <!-- /Search Form -->
        <!-- DataTable -->
        <table class="table dataTable datatable-column-search-inputs"
               id="RequisitionItemList">

            <thead>

                <tr>

                    <th>
                        Requisition ID
                    </th>

                    <th>
                        Date
                    </th>

                    <th>
                        Requisition Code
                    </th>

                    @*<th>
                            Requisition Name
                        </th>*@

                    <th>
                        Requested By
                    </th>

                    <th>
                        Job No
                    </th>

                    <th>
                        Status
                    </th>

                    @*<th>
                            Approval
                        </th>

                        <th>
                            Issued
                        </th>*@

                    <th class="text-center">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>
            </tbody>


            <tfoot>

                <tr>

                    <td>
                        Requisition ID
                    </td>

                    <td>
                        Date
                    </td>

                    <td>
                        Requisition Code
                    </td>

                    @*<td>
                            Requisition Name
                        </td>*@

                    <td>
                        Requested By
                    </td>

                    <td>
                        Job No
                    </td>

                    <td>
                        Status
                    </td>

                    @*<td>
                            Approval
                        </td>

                        <td>
                            Issued
                        </td>*@

                    <td>
                    </td>

                </tr>

            </tfoot>

        </table>
        <!-- /DataTable -->

    </div>

</div>
<!-- /content -->


@section ChildpageJavaScript
{

    <script>

    var dtTable;


    // ============================================================
    // Status Badge
    // ============================================================

    function StatusBadge(status) {

        if (status == 0) {
            return "<span class='badge badge-info'>New</span>";
        }

        if (status == 1) {
            return "<span class='badge badge-success'>FORWARDED</span>";
        }

        if (status == 2) {
            return "<span class='badge badge-primary'>APPROVED</span>";
        }
        if (status == 3) {
            return "<span class='badge badge-primary'>REJECTED</span>";
        }

        if (status == 4) {
            return "<span class='badge badge-danger'>ISSUED</span>";
        }

        return "<span class='badge badge-secondary'>UNKNOWN</span>";
    }


    // ============================================================
    // Approval Badge
    // ============================================================

    function ApprovalBadge(value) {

        if (value == 1) {

            return "<span class='badge badge-success'>" +
                   "<i class='icon-checkmark3 mr-1'></i> Approved" +
                   "</span>";
        }

        return "<span class='badge badge-warning'>" +
               "<i class='icon-hour-glass mr-1'></i> Pending" +
               "</span>";
    }


    // ============================================================
    // Issue Badge
    // ============================================================

    function IssueBadge(value) {

        if (value == 1) {

            return "<span class='badge badge-success'>" +
                   "<i class='icon-checkmark3 mr-1'></i> Issued" +
                   "</span>";
        }

        return "<span class='badge badge-secondary'>" +
               "Not Issued" +
               "</span>";
    }


    // ============================================================
    // Date Format
    // Handles BOTH:
    //   - ASP.NET MVC's default JsonResult date format: /Date(1699999999999)/
    //   - Plain ISO strings, in case JSON.NET/Web API is used instead
    // ============================================================

    function FormatDate(value) {

        if (!value) {
            return "";
        }

        var date;

        var aspNetMatch = /\/Date\((\d+)\)\//.exec(value);

        if (aspNetMatch) {
            date = new Date(parseInt(aspNetMatch[1], 10));
        } else {
            date = new Date(value);
        }

        if (isNaN(date.getTime())) {
            return value;
        }

        var day = ("0" + date.getDate()).slice(-2);
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var year = date.getFullYear();

        return day + "-" + month + "-" + year;
    }


    // ============================================================
    // Reload DataTable
    // ============================================================

    function ReloadDataTable() {

        dtTable.ajax.url(

            "@Url.Action("GetInvDepartmentRequisitionItemList", "InvDepartmentRequisition2nd")?"
            + $("#my-form").serialize()

        ).load();

    }


    // ============================================================
    // Reset Search
    // ============================================================

    function ResetSearch() {

        $("#my-form")[0].reset();

        ReloadDataTable();

    }


    // ============================================================
    // Update DataTable
    // ============================================================

    function UpdateDataTable() {

        dtTable = $('#RequisitionItemList').DataTable({

            processing: true,

            serverSide: true,

            method: "GET",

            ajax: {

                url:
                    "@Url.Action("GetInvDepartmentRequisitionItemList", "InvDepartmentRequisition2nd")?"
                    + $("#my-form").serialize(),

                type: "GET",

                dataSrc: "data",

                error: function (xhr, status, thrown) {

                    console.error(
                        "Requisition list failed to load — HTTP",
                        xhr.status, xhr.responseText
                    );

                }

            },


            columns: [


                {
                    data: 'RequisitionId'
                },

                {
                    data: 'RequisitionDate',

                    render: function (data, type, row) {

                        if (type === 'display' || type === 'filter') {

                            return FormatDate(data);

                        }

                        return data;
                    }
                },


                {
                    data: 'RequisitionCode',

                    render: function (data, type, row) {

                        return data || "";

                    }
                },

                //{
                //    data: 'RequisitionName',

                //    render: function (data, type, row) {

                //        return data || "";

                //    }
                //},

                {
                    data: 'RequestedByName',

                    render: function (data, type, row) {

                        return data || row.RequestedBy || "";

                    }
                },

                {
                    data: 'JobNo',

                    render: function (data, type, row) {

                        return data || "";

                    }
                },

                {
                    data: 'Status',

                    className: "text-center",

                    render: function (data, type, row) {

                        if (type === 'display') {

                            return StatusBadge(data);

                        }

                        return data;

                    }
                },


                // ------------------------------------------------
                // Approval
                // ------------------------------------------------

                //{
                //    data: 'IsApproved',

                //    className: "text-center",

                //    render: function (data, type, row) {

                //        if (type === 'display') {

                //            return ApprovalBadge(data);

                //        }

                //        return data;

                //    }
                //},


                // ------------------------------------------------
                // Issued
                // ------------------------------------------------

                //{
                //    data: 'IsIssued',

                //    className: "text-center",

                //    render: function (data, type, row) {

                //        if (type === 'display') {

                //            return IssueBadge(data);

                //        }

                //        return data;

                //    }
                //},


                // ------------------------------------------------
                // Actions
                // ------------------------------------------------

                {
                    data: 'RowId',

                    orderable: false,

                    searchable: false,

                    className: "text-center",

                    render: function (data, type, row) {

                        var retVal =

                            "<div class='list-icons'>" +

                            "<div class='dropdown'>" +

                            "<a href='#' " +
                            "class='list-icons-item' " +
                            "data-toggle='dropdown'>" +

                            "<i class='icon-menu9'></i>" +

                            "</a>" +

                            "<div class='dropdown-menu dropdown-menu-right'>" +


                            // ------------------------------------
                            // Edit
                            // ------------------------------------

                            "<a href='@Url.Action("Edit", "InvDepartmentRequisition2nd")/" +
                            data +
                            "' class='dropdown-item text-blue'>" +

                            "<i class='icon-pencil7'></i> " +
                            "Edit Information" +

                            "</a>" +


                            // ------------------------------------
                            // Delete
                            // ------------------------------------

                            "<a href='@Url.Action("Delete", "InvDepartmentRequisition2nd")/" +
                            data +
                            "' class='dropdown-item text-danger'>" +

                            "<i class='icon-cross'></i> " +
                            "Delete Information" +

                            "</a>" +


                            "</div>" +

                            "</div>" +

                            "</div>";


                        return retVal;

                    }

                }

            ]

        });

    }


    // ============================================================
    // Document Ready
    // ============================================================

    $(document).ready(function () {

        UpdateDataTable();

    });

    </script>

}
