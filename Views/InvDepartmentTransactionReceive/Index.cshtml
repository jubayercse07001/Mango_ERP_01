@using ERP.Models.Inventory.InvDepartmentRequisition

@{
    ViewBag.Title = "Department Transaction Receive";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <span class="breadcrumb-item">Inventory</span>
                <span class="breadcrumb-item active">Department Transaction Receive</span>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="card">
        <div class="card-header header-elements-inline">
            <h5 class="card-title">List of Department Transaction Receives</h5>
            <div class="header-elements">
                <button type="button" class="btn btn-light mr-3 text-success"
                        onclick="$('#my-form').toggle();">
                    <i class="icon-search4 mr-2"></i> Advance Search
                </button>
                <button type="button" class="btn btn-light text-danger-300"
                        onclick="ResetSearch();">
                    <i class="icon-reset mr-2"></i> Reset Search
                </button>
            </div>
        </div>

        <form id="my-form" style="display:none;">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Requisition Code</label>
                            <input type="text" id="RequisitionCode" name="RequisitionCode"
                                   class="form-control" placeholder="Requisition Code" />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Requisition Name</label>
                            <input type="text" id="RequisitionName" name="RequisitionName"
                                   class="form-control" placeholder="Requisition Name" />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Department</label>
                            <select id="DepartmentId" name="DepartmentId" class="form-control">
                                <option value="">-- Select Department --</option>
                                @if (ViewBag.DepartmentList != null)
                                {
                                    foreach (var item in ViewBag.DepartmentList)
                                    {
                                        <option value="@item.RowId">@item.DepartmentName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Job No</label>
                            <input type="text" id="JobNo" name="JobNo"
                                   class="form-control" placeholder="Job No" />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>From Date</label>
                            <input type="date" id="FromDate" name="FromDate" class="form-control" />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>To Date</label>
                            <input type="date" id="ToDate" name="ToDate" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-light text-brown-300"
                            onclick="$('#my-form').hide();">
                        Close Search Panel
                    </button>
                    <div>
                        <button type="button" class="btn btn-light text-danger-300 mr-2"
                                onclick="ResetSearch();">
                            <i class="icon-reset mr-2"></i> Reset Search
                        </button>
                        <button type="button" class="btn btn-primary"
                                onclick="ReloadDataTable();">
                            <i class="icon-search4 mr-2"></i> Search
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <table class="table datatable-column-search-inputs" id="RequisitionItemList">
            <thead>
                <tr>
                    <th>Requisition ID</th>
                    <th>Date</th>
                    <th>Requisition Code</th>
                    <th>Requested By</th>
                    <th>Department</th>
                    <th>Job No</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section ChildpageJavaScript
{
    <script type="text/javascript">
    var dtTable = null;

    function StatusBadge(status) {
        status = parseInt(status);
        switch (status) {
            case 0: return "<span class='badge badge-info'>NEW</span>";
            case 1: return "<span class='badge badge-warning'>FORWARDED</span>";
            case 2: return "<span class='badge badge-primary'><i class='icon-checkmark3 mr-1'></i> APPROVED</span>";
            case 3: return "<span class='badge badge-danger'>REJECTED</span>";
            case 4: return "<span class='badge badge-success'><i class='icon-checkmark3 mr-1'></i> ISSUED</span>";
            case 5: return "<span class='badge badge-secondary'>RECEIVED</span>";
            default: return "<span class='badge badge-secondary'>UNKNOWN</span>";
        }
    }

    function FormatDate(value) {
        if (!value) return "";
        var date;
        var aspNetMatch = /\/Date\((\d+)\)\//.exec(value);
        if (aspNetMatch) {
            date = new Date(parseInt(aspNetMatch[1], 10));
        } else {
            date = new Date(value);
        }
        if (isNaN(date.getTime())) return value;
        var day = ("0" + date.getDate()).slice(-2);
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var year = date.getFullYear();
        return day + "-" + month + "-" + year;
    }

    function ReloadDataTable() {
        if (dtTable == null) return;
        var searchUrl =
            "@Url.Action("GetInvDepartmentRequisitionItemList", "InvDepartmentTransactionReceive")?" +
            $("#my-form").serialize();
        dtTable.ajax.url(searchUrl).load();
    }

    function ResetSearch() {
        $("#my-form")[0].reset();
        ReloadDataTable();
    }

    function UpdateDataTable() {
        dtTable = $("#RequisitionItemList").DataTable({
            processing: true,
            serverSide: true,
            searching: true,
            ordering: true,
            pageLength: 10,
            lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
            ajax: {
                url: "@Url.Action("GetInvDepartmentRequisitionItemList", "InvDepartmentTransactionReceive")?" +
                     $("#my-form").serialize(),
                type: "GET",
                dataSrc: function (json) {
                    if (json.error) console.error("Server Error:", json.error);
                    return json.data || [];
                },
                error: function (xhr) {
                    console.error("Receive list error:", xhr.status, xhr.responseText);
                }
            },
            columns: [
                { data: "RequisitionId", defaultContent: "" },
                {
                    data: "RequisitionDate", defaultContent: "",
                    render: function (data, type) {
                        if (type === "display" || type === "filter") return FormatDate(data);
                        return data;
                    }
                },
                { data: "RequisitionCode", defaultContent: "" },
                {
                    data: "RequestedByName", defaultContent: "",
                    render: function (data, type, row) { return data || row.RequestedBy || ""; }
                },
                { data: "DepartmentName", defaultContent: "" },
                { data: "JobNo", defaultContent: "" },
                {
                    data: "Status", className: "text-center",
                    render: function (data, type) {
                        if (type === "display") return StatusBadge(data);
                        return data;
                    }
                },
                {
                    data: "RowId", orderable: false, searchable: false, className: "text-center",
                    render: function (data, type, row) {
                        if (parseInt(row.Status) !== 4 || parseInt(row.IsIssued) !== 1)
                            return "";

                        var receiveUrl =
                            "@Url.Action("Receive", "InvDepartmentTransactionReceive")" +
                            "?id=" + encodeURIComponent(data);

                        return (
                            "<div class='list-icons'>" +
                                "<div class='dropdown'>" +
                                    "<a href='#' class='list-icons-item' data-toggle='dropdown'>" +
                                        "<i class='icon-menu9'></i>" +
                                    "</a>" +
                                    "<div class='dropdown-menu dropdown-menu-right'>" +
                                        "<a href='" + receiveUrl + "' class='dropdown-item text-primary'>" +
                                            "<i class='icon-download4 mr-2'></i> Receive Requisition" +
                                        "</a>" +
                                    "</div>" +
                                "</div>" +
                            "</div>"
                        );
                    }
                }
            ],
            order: [[0, "desc"]],
            language: {
                processing: "Loading...",
                emptyTable: "No issued requisition available for receive.",
                zeroRecords: "No matching issued requisition found."
            }
        });
    }

    $(document).ready(function () {
        UpdateDataTable();
    });
    </script>
}