@using ERP.Models.HR.Organization.HrCompanyInformation;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Home Page";
}

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index", "HrCompanyInformation")"
                   class="breadcrumb-item">
                    HrCompanyInformation
                </a>

                <span class="breadcrumb-item active">
                    Delete
                </span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>

        </div>

    </div>

</div>

<!-- Content area -->
<div class="content">

    <form action="#"
          id="my-form">

        <div class="card"
             id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Delete Existing Company Information
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.HrCompanyInformation.RowId" />

            </div>

            <!-- WARNING -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-danger">

                        <h2>
                            Are you sure to delete the following Company Information?
                        </h2>

                    </div>

                </div>

            </div>

            <!-- BODY -->
            <div class="card-body">

                <div class="row">

                    <!-- LEFT COLUMN -->
                    <div class="col-md-6">

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Company Name:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.CompanyName

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Short Name:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.ShortCompanyName

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Address:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.AddressLine1

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Phone:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.Phone1

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Mobile:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.Mobile1

                            </div>

                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="col-md-6">

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Fax:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.Fax

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Email:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.Email1

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Website:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.Web

                            </div>

                        </div>

                        <div class="form-group row mb-0">

                            <label class="col-form-label col-lg-4">
                                Logo URL:
                            </label>

                            <div class="col-lg-8 pt-2">

                                @ViewBag.HrCompanyInformation.LogoUrl

                            </div>

                        </div>

                        @if (!string.IsNullOrEmpty(ViewBag.HrCompanyInformation.LogoUrl))
                        {
                            <div class="form-group row mb-0">

                                <label class="col-form-label col-lg-4">
                                    Logo:
                                </label>

                                <div class="col-lg-8 pt-2">

                                    <img src="@ViewBag.HrCompanyInformation.LogoUrl"
                                         alt="Company Logo"
                                         style="max-height:80px; border:1px solid #ddd; padding:5px;" />

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <!-- ERROR DIV -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">

                    </div>

                </div>

            </div>

            <!-- SUCCESS DIV -->
            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h2>
                            Company Information has been deleted successfully.
                        </h2>

                    </div>

                </div>

            </div>

            <!-- BUTTONS -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <button type="button"
                                    id="btnSubmit"
                                    class="btn bg-danger ml-3">

                                Delete
                                <i class="icon-cross ml-2"></i>

                            </button>

                            <a href="@Url.Action("Index", "HrCompanyInformation")"
                               class="btn btn-light">

                                Back to List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript{

    <script>

        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({

                    type: "POST",

                    url: "@Url.Action("Delete", "HrCompanyInformation")",

                    data: $("#my-form").serialize(),

                    success: function (data) {

                        if (data.ResponseStatus == -1) {

                            window.location.href =
                                "@Url.Action("Logout", "Login")";
                        }
                        else if (data.ResponseStatus == -2) {

                            window.location.href =
                                "@Url.Action("Index", "HrCompanyInformation")";
                        }
                        else if (data.ResponseStatus == 0) {

                            $("#errormessage").html(data.ResponseMessage);

                            $("#successdiv").hide();
                            $("#errordiv").show();
                        }
                        else {

                            $("#errormessage").html("");

                            $("#errordiv").hide();

                            $("#btnSubmit").hide();

                            $("#successdiv").show();
                        }

                    },

                    error: function (xhr, status, error) {

                        console.log(xhr.responseText);

                        $("#errormessage").html(xhr.responseText);

                        $("#successdiv").hide();
                        $("#errordiv").show();
                    }

                });

            });

        });

    </script>

}