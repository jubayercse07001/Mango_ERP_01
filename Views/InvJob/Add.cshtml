
@using ERP.Models.Inventory.InvJob

@{
    ViewBag.Title = "Add Inventory Job";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">

        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index","Home")"
                   class="breadcrumb-item">

                    <i class="icon-home2 mr-2"></i> Home

                </a>

                <a href="@Url.Action("Index","InvJob")"
                   class="breadcrumb-item">

                    Inventory Job

                </a>

                <span class="breadcrumb-item active">
                    Add
                </span>

            </div>

        </div>

    </div>

</div>


<div class="content">

    <form id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Add New Inventory Job
                </h6>

            </div>


            <div class="card-body">

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <!-- Job No -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Job No
                            </label>
                            <div class="col-lg-8">
                                <input type="text"
                                       name="JobNo"
                                       id="JobNo"
                                       class="form-control"
                                       value=""
                                       readonly />
                                </div>

                            </div>


                            <!-- Job Name -->
                            <div class="form-group row">

                                <label class="col-lg-4 col-form-label">

                                    <span class="text-danger">*</span>
                                    Job Name

                                </label>

                                <div class="col-lg-8">

                                    <input type="text"
                                           name="JobName"
                                           id="JobName"
                                           class="form-control"
                                           maxlength="256"
                                           placeholder="Job Name"
                                           autocomplete="off" />

                                </div>

                            </div>


                            <!-- Department -->
                            <div class="form-group row">

                                <label class="col-lg-4 col-form-label">

                                    <span class="text-danger">*</span>
                                    Department

                                </label>

                                <div class="col-lg-8">

                                    <select name="DepartmentId"
                                            id="DepartmentId"
                                            class="form-control">

                                        <option value="">
                                            Select Department
                                        </option>

                                        @if (ViewBag.DepartmentList != null)
                                        {
                                            foreach (var item in ViewBag.DepartmentList)
                                            {
                                                <option value="@item.RowId">
                                                    @item.DepartmentName
                                                </option>
                                            }
                                        }

                                    </select>

                                </div>

                            </div>

                        </div>


                    <!-- Right Column -->
                    <div class="col-md-6">

                        <!-- Start Date -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Start Date
                            </label>

                            <div class="col-lg-8">

                                <input type="date"
                                       name="StartDate"
                                       id="StartDate"
                                       class="form-control" />

                            </div>

                        </div>


                        <!-- End Date -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                End Date
                            </label>

                            <div class="col-lg-8">

                                <input type="date"
                                       name="EndDate"
                                       id="EndDate"
                                       class="form-control" />

                            </div>

                        </div>


                        <!-- Status -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Status
                            </label>

                            <div class="col-lg-8">

                                <select name="Status"
                                        id="Status"
                                        class="form-control">

                                    <option value="1" selected>
                                        Open
                                    </option>

                                    <option value="2">
                                        In Progress
                                    </option>

                                    <option value="3">
                                        Completed
                                    </option>

                                    <option value="4">
                                        Cancelled
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- Job Description -->
                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Description
                            </label>

                            <div class="col-lg-8">

                                <textarea name="JobDescription"
                                          id="JobDescription"
                                          rows="3"
                                          maxlength="500"
                                          class="form-control"
                                          placeholder="Job Description"></textarea>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Error Message -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>


            <!-- Buttons -->
            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <button type="button"
                            id="btnSubmit"
                            class="btn bg-blue">

                        Submit

                        <i class="icon-paperplane ml-2"></i>

                    </button>


                    <a href="@Url.Action("Index","InvJob")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>


        <!-- Success -->
        <div class="card"
             id="successdiv"
             style="display:none">

            <div class="card-header bg-white">

                <h6 class="card-title">
                    Inventory Job Added Successfully
                </h6>

            </div>


            <div class="card-body">

                <h4 class="text-success">

                    Inventory job information has been
                    added successfully.

                </h4>

            </div>


            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between">

                    <a href="@Url.Action("Add","InvJob")"
                       class="btn btn-light">

                        Add Another

                    </a>


                    <a href="@Url.Action("Index","InvJob")"
                       class="btn btn-light">

                        Back To List

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>


@section ChildpageJavaScript
{
    <script>

        $(document).ready(function () {


            // =====================================================
            // Submit
            // =====================================================

            $("#btnSubmit").click(function () {


                // Hide previous error
                $("#errordiv").hide();
                $("#errormessage").html("");


                // =================================================
                // Validation
                // =================================================

                var jobName =
                    $.trim($("#JobName").val());

                var departmentId =
                    $("#DepartmentId").val();


                if (jobName === "") {

                    $("#errormessage").html(
                        "Job Name is required."
                    );

                    $("#errordiv").show();

                    $("#JobName").focus();

                    return false;
                }


                if (departmentId === "") {

                    $("#errormessage").html(
                        "Please select a Department."
                    );

                    $("#errordiv").show();

                    $("#DepartmentId").focus();

                    return false;
                }


                // =================================================
                // Disable Submit Button
                // =================================================

                $("#btnSubmit")
                    .prop("disabled", true)
                    .html(
                        'Saving... <i class="icon-spinner2 spinner ml-2"></i>'
                    );


                // =================================================
                // AJAX POST
                // =================================================

                $.ajax({

                    type: "POST",

                    url: '@Url.Action("Add", "InvJob")',

                    data: $("#my-form").serialize(),

                    success: function (data) {


                        // Session expired
                        if (data.ResponseStatus == -1) {

                            window.location.href =
                                '@Url.Action("Logout","Login")';

                            return;
                        }


                        // Permission denied
                        else if (data.ResponseStatus == -2) {

                            window.location.href =
                                '@Url.Action("Index","InvJob")';

                            return;
                        }


                        // Validation error
                        else if (data.ResponseStatus == 0) {

                            $("#errormessage").html(
                                data.ResponseMessage
                            );

                            $("#errordiv").show();


                            $("#btnSubmit")
                                .prop("disabled", false)
                                .html(
                                    'Submit <i class="icon-paperplane ml-2"></i>'
                                );

                            return;
                        }


                        // Success
                        else {

                            $("#errordiv").hide();

                            $("#maindiv").hide();

                            $("#successdiv").show();

                        }

                    },


                    error: function (xhr) {

                        $("#errormessage").html(
                            "An unexpected error occurred. Please try again."
                        );

                        $("#errordiv").show();


                        $("#btnSubmit")
                            .prop("disabled", false)
                            .html(
                                'Submit <i class="icon-paperplane ml-2"></i>'
                            );

                    }

                });

            });

            
            function updateJob() {

    $.ajax({
        url: '@Url.Action("GetnextJob", "InvJob")',
        type: 'GET',
        cache: false,

        success: function (jobIdValue) {

            var jobId = parseInt(jobIdValue, 10);

            if (!isNaN(jobId)) {

                var jobNo = "JOB-I-" +
                    jobId.toString().padStart(6, "0");

                $("#JobNo").val(jobNo);

            } else {

                $("#JobNo").val("");
            }
        },

        error: function () {

            $("#JobNo").val("");

            $("#errormessage").html(
                "Unable to generate Job No. Please try again."
            );

            $("#errordiv").show();
        }
    });
}


$(document).ready(function () {

    updateJob();

});
            // =====================================================
            // Enter Key
            // =====================================================

            $("#JobName").keypress(function (e) {

                if (e.which == 13) {

                    e.preventDefault();

                    $("#btnSubmit").click();

                }

            });

        });

    </script>
}
