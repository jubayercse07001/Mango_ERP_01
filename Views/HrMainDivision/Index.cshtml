@using ERP.Models.HR.Organization.HrMainDivision;

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="page-header page-header-light ">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")"
                   class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <span class="breadcrumb-item active">
                    HrMainDivision
                </span>
            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>
        </div>

        <div class="header-elements d-none">
            <div class="breadcrumb justify-content-center">
            </div>
        </div>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <!-- Individual column searching (text inputs) -->
    <div class="card">

        <div class="card-header header-elements-inline">

            <h5 class="card-title">
                List of Main Divisions
            </h5>

            <div class="header-elements">

                <a href="Javascript:$('#my-form').toggle()">
                    <button type="button"
                            class="btn btn-light mr-3 text-success">

                        <i class="icon-search4 mr-2"></i>
                        Advance Search
                    </button>
                </a>

                <a href="@Url.Action("Index", "HrMainDivision")"
                   class="text-danger-300">

                    <button type="button"
                            class="btn btn-light mr-3 text-danger-300">

                        <i class="icon-reset mr-2"></i>
                        Reset Search
                    </button>
                </a>

                <button type="button" class="btn btn-light">

                    <a href="@Url.Action("Add", "HrMainDivision")">
                        <i class="icon-add mr-2"></i>
                        Add New
                    </a>

                </button>

            </div>
        </div>

        <form action=""
              id="my-form"
              style="display:none">

            <div class="card-body row">

            </div>

            <div class="card-footer bg-white">

                <div class="row" mb-0>

                    <div class="col-lg-12 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <a href="Javascript:$('#my-form').toggle();">

                                <button type="button"
                                        class="btn btn-light text-brown-300">

                                    Close Search Pannel
                                </button>

                            </a>

                            <a href="javascript:ResetSearch();">

                                <button type="button"
                                        class="btn btn-light text-danger-300">

                                    Reset Search
                                </button>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <hr />

        </form>

        <table class="table dataTable datatable-column-search-inputs"
               id="MainDivisionItemList">

            <thead>

                <tr>
                    <th>Id</th>
                    <th>Main Division Name</th>
                    <th>Short Name</th>
                    <th>Address</th>
                    <th>Phone</th>
                    <th>Rank</th>
                    <th class="text-center">Actions</th>
                </tr>

            </thead>

            <tbody>
            </tbody>

            <tfoot>

                <tr>
                    <td>Id</td>
                    <td>Main Division Name</td>
                    <td>Short Name</td>
                    <td>Address</td>
                    <td>Phone</td>
                    <td>Rank</td>
                    <td></td>
                </tr>

            </tfoot>

        </table>

    </div>
    <!-- /individual column searching (text inputs) -->

</div>
<!-- /content area -->

@section ChildpageJavaScript{

    <script>

        function ReloadDataTable() {

            dtTable.ajax.url(
                "@Url.Action("GetHrMainDivisionItemList", "HrMainDivision")?"
                + $("#my-form").serialize()
            ).load();
        }

        function ResetSearch() {

            $("#my-form").trigger("reset");

            ReloadDataTable();
        }

        function UpdateDataTable() {

            dtTable = $('#MainDivisionItemList').DataTable({

                "processing": true,

                "serverSide": true,

                "method": 'GET',

                "ajax":
                    "@Url.Action("GetHrMainDivisionItemList", "HrMainDivision")?"
                    + $("#my-form").serialize(),

                columns: [

                    { data: 'MainDivisionId' },

                    { data: 'MainDivisionName' },

                    { data: 'ShortMainDivisionName' },

                    { data: 'Address' },

                    { data: 'Phone' },

                    { data: 'Rank' },

                    {
                        "mData": "RowId",

                        "mRender": function (data, type, row) {

                            var retVal =
                                "<div class=\"list-icons\">" +
                                "<div class=\"dropdown\">" +

                                "<a href=\"#\" class=\"list-icons-item\" data-toggle=\"dropdown\">" +
                                "<i class=\"icon-menu9\"></i>" +
                                "</a>" +

                                "<div class=\"dropdown-menu dropdown-menu-right\">" +

                                "<a href=\"@Url.Action("Edit", "HrMainDivision")/" + data + "\" class=\"dropdown-item text-blue\">" +
                                "<i class=\"icon-pencil7\"></i> Edit Information</a>" +

                                "<a href=\"@Url.Action("Delete", "HrMainDivision")/" + data + "\" class=\"dropdown-item text-danger\">" +
                                "<i class=\"icon-cross\"></i> Delete Information</a>" +

                                "</div>" +
                                "</div>" +
                                "</div>";

                            return retVal;
                        }
                    }

                ]

            });
        }

        $(document).ready(function () {

            UpdateDataTable();

        });

    </script>
}