@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delete Main Division";
}

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index", "HrMainDivision")" class="breadcrumb-item">
                    HrMainDivision
                </a>

                <span class="breadcrumb-item active">Delete</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>
        </div>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <form action="#" id="my-form">

        <div class="card" id="maindiv">

            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Delete Existing Main Division</h6>

                <input type="hidden" name="RowId" value="@ViewBag.HrMainDivision.RowId" />
            </div>

            <!-- Warning Message -->
            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-danger">
                        <h2>Are you sure to delete the following Main Division?</h2>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="card-body">

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-2">Main Division Id:</label>

                    <div class="col-lg-10 pt-2">
                        @ViewBag.HrMainDivision.MainDivisionId
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-2">Main Division Name:</label>

                    <div class="col-lg-10 pt-2">
                        @ViewBag.HrMainDivision.MainDivisionName
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-2">Short Name:</label>

                    <div class="col-lg-10 pt-2">
                        @ViewBag.HrMainDivision.ShortMainDivisionName
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-2">Address:</label>

                    <div class="col-lg-10 pt-2">
                        @ViewBag.HrMainDivision.Address
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-2">Phone:</label>

                    <div class="col-lg-10 pt-2">
                        @ViewBag.HrMainDivision.Phone
                    </div>
                </div>

                <div class="form-group row mb-0">
                    <label class="col-form-label col-lg-2">Rank:</label>

                    <div class="col-lg-10 pt-2">
                        @ViewBag.HrMainDivision.Rank
                    </div>
                </div>

            </div>

            <!-- Error Message -->
            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage">
                        there
                    </div>
                </div>
            </div>

            <!-- Success Message -->
            <div class="card-footer bg-white" id="successdiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-success">
                        <h2>Main Division has been deleted successfully.</h2>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto">

                        <div class="d-flex justify-content-between align-items-center">

                            <button type="button"
                                    id="btnSubmit"
                                    class="btn bg-danger ml-3">
                                Delete
                                <i class="icon-cross ml-2"></i>
                            </button>

                            <button type="button" class="btn btn-light">
                                <a href="@Url.Action("Index", "HrMainDivision")">
                                    Back to List
                                </a>
                            </button>

                        </div>

                    </div>
                </div>
            </div>

        </div>

    </form>

</div>
<!-- /content area -->

@section ChildpageJavaScript{

    <script>

        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({
                    type: "POST",

                    url: "@Url.Action("Delete", "HrMainDivision")",

                    data: $("#my-form").serialize(),

                    success: function (data) {

                        if (data.ResponseStatus == -1) {

                            window.location.href =
                                "@Url.Action("Logout", "Login")";

                        }
                        else if (data.ResponseStatus == -2) {

                            window.location.href =
                                "@Url.Action("Index", "HrMainDivision")";

                        }
                        else if (data.ResponseStatus == 0) {

                            $("#errormessage").html(data.ResponseMessage);

                            $("#successdiv").hide();

                            $("#errordiv").show();
                        }
                        else {

                            $("#errormessage").html("");

                            $("#errordiv").hide();

                            $("#btnSubmit").hide();

                            $("#successdiv").show();
                        }
                    }
                });

            });

        });

    </script>

}