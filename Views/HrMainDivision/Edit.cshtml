@using ERP.Models.HR.Organization.HrMainDivision;

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="page-header page-header-light">

    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">

            <div class="breadcrumb">

                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>

                <a href="@Url.Action("Index", "HrMainDivision")"
                   class="breadcrumb-item">
                    HrMainDivision
                </a>

                <span class="breadcrumb-item active">Edit</span>

            </div>

            <a href="#"
               class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>

        </div>
    </div>

</div>

<!-- Content area -->
<div class="content">

    <form action="#"
          id="my-form">

        <div class="card"
             id="maindiv">

            <div class="card-header bg-white header-elements-inline">

                <h6 class="card-title">
                    Edit Existing Main Division
                </h6>

                <input type="hidden"
                       name="RowId"
                       value="@ViewBag.HrMainDivision.RowId" />

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- LEFT COLUMN -->
                    <div class="col-md-6">

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                <span class="text-danger">*</span>
                                Main Division Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="MainDivisionName"
                                       class="form-control"
                                       placeholder="Main Division Name"
                                       value="@ViewBag.HrMainDivision.MainDivisionName">

                            </div>

                        </div>

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Short Name
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="ShortMainDivisionName"
                                       class="form-control"
                                       placeholder="Short Main Division Name"
                                       value="@ViewBag.HrMainDivision.ShortMainDivisionName">

                            </div>

                        </div>

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Address
                            </label>

                            <div class="col-lg-8">

                                <textarea name="Address"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Enter Address">@ViewBag.HrMainDivision.Address</textarea>

                            </div>

                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="col-md-6">

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Phone
                            </label>

                            <div class="col-lg-8">

                                <input type="text"
                                       name="Phone"
                                       class="form-control"
                                       placeholder="Phone"
                                       value="@ViewBag.HrMainDivision.Phone">

                            </div>

                        </div>

                        <div class="form-group row">

                            <label class="col-lg-4 col-form-label">
                                Rank
                            </label>

                            <div class="col-lg-8">

                                <input type="number"
                                       name="Rank"
                                       class="form-control"
                                       placeholder="Rank"
                                       value="@ViewBag.HrMainDivision.Rank">

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ERROR DIV -->
            <div class="card-footer bg-white"
                 id="errordiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-warning"
                         id="errormessage">
                    </div>

                </div>

            </div>

            <!-- SUCCESS DIV -->
            <div class="card-footer bg-white"
                 id="successdiv"
                 style="display:none">

                <div class="row">

                    <div class="col-lg-10 ml-lg-auto text-success">

                        <h2>
                            Main Division has been updated successfully.
                        </h2>

                    </div>

                </div>

            </div>

            <!-- BUTTONS -->
            <div class="card-footer bg-white">

                <div class="row">

                    <div class="col-lg-12">

                        <div class="d-flex justify-content-between align-items-center">

                            <button type="button"
                                    id="btnSubmit"
                                    class="btn bg-blue">

                                Submit
                                <i class="icon-paperplane ml-2"></i>

                            </button>

                            <a href="@Url.Action("Index", "HrMainDivision")"
                               class="btn btn-light">

                                Back to List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section ChildpageJavaScript{

    <script>

        $(document).ready(function () {

            $("#btnSubmit").click(function () {

                $.ajax({

                    type: "POST",

                    url: '@Url.Action("Edit", "HrMainDivision")',

                    data: $("#my-form").serialize(),

                    success: function (data) {

                        if (data.ResponseStatus == -1) {

                            window.location.href =
                                '@Url.Action("Logout", "Login")';

                        }
                        else if (data.ResponseStatus == -2) {

                            window.location.href =
                                '@Url.Action("Index", "HrMainDivision")';

                        }
                        else if (data.ResponseStatus == 0) {

                            $("#errormessage").html(data.ResponseMessage);

                            $("#successdiv").hide();
                            $("#errordiv").show();

                        }
                        else {

                            $("#errormessage").html("");

                            $("#errordiv").hide();
                            $("#successdiv").show();

                        }
                    },

                    error: function (xhr, status, error) {

                        console.log(xhr.responseText);

                        $("#errormessage").html(xhr.responseText);

                        $("#successdiv").hide();
                        $("#errordiv").show();
                    }

                });

            });

        });

    </script>

}