@using ERP.Models.HR.Organization.HrDivisionDesignationMap;

@{
    ViewBag.Title = "Division Designation Map";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <span class="breadcrumb-item active">
                    Division Designation Map
                </span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none">
                <i class="icon-more"></i>
            </a>
        </div>

        <div class="header-elements d-none">
            <div class="breadcrumb justify-content-center">
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="card">
        <div class="card-header header-elements-inline">
            <h5 class="card-title">
                List of Division Designation Maps
            </h5>

            <div class="header-elements">
                <a href="Javascript:$('#my-form').toggle()">
                    <button type="button" class="btn btn-light mr-3 text-success">
                        <i class="icon-search4 mr-2"></i> Advance Search
                    </button>
                </a>

                <a href="@Url.Action("Index", "HrDivisionDesignationMap")">
                    <button type="button" class="btn btn-light mr-3 text-danger-300">
                        <i class="icon-reset mr-2"></i> Reset Search
                    </button>
                </a>

                <button type="button" class="btn btn-light">
                    <a href="@Url.Action("Add", "HrDivisionDesignationMap")">
                        <i class="icon-add mr-2"></i> Add New
                    </a>
                </button>
            </div>
        </div>

        <form id="my-form" style="display:none">
            <div class="card-body row">
            </div>

            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-12 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <a href="Javascript:$('#my-form').toggle();">
                                <button type="button" class="btn btn-light text-brown-300">
                                    Close Search Panel
                                </button>
                            </a>

                            <a href="javascript:ResetSearch();">
                                <button type="button" class="btn btn-light text-danger-300">
                                    Reset Search
                                </button>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <hr />
        </form>

        <table class="table dataTable datatable-column-search-inputs" id="DivisionDesignationMapItemList">
            <thead>
                <tr>
                    <th>Map ID</th>
                    <th>Division</th>
                    <th>Designation</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    <td>Map ID</td>
                    <td>Division</td>
                    <td>Designation</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section ChildpageJavaScript
{
    <script>
        var dtTable;

        function ReloadDataTable() {
            dtTable.ajax.url(
                "@Url.Action("GetHrDivisionDesignationMapItemList", "HrDivisionDesignationMap")?"
                + $("#my-form").serialize()
            ).load();
        }

        function ResetSearch() {
            $("#my-form").trigger("reset");
            ReloadDataTable();
        }

        function UpdateDataTable() {
            dtTable = $('#DivisionDesignationMapItemList').DataTable({
                "processing": true,
                "serverSide": true,
                "method": "GET",
                "ajax": "@Url.Action("GetHrDivisionDesignationMapItemList", "HrDivisionDesignationMap")?"
                        + $("#my-form").serialize(),
                columns: [
                    { data: 'MapId' },
                    { data: 'DivisionName' },
                    { data: 'DesignationName' },
                    {
                        "mData": "RowId",
                        "mRender": function (data, type, row) {
                            var retVal =
                            "<div class='list-icons'>" +
                                "<div class='dropdown'>" +
                                    "<a href='#' class='list-icons-item' data-toggle='dropdown'>" +
                                        "<i class='icon-menu9'></i>" +
                                    "</a>" +
                                    "<div class='dropdown-menu dropdown-menu-right'>" +
                                        "<a href='@Url.Action("Edit", "HrDivisionDesignationMap")/" + data + "' class='dropdown-item text-blue'>" +
                                            "<i class='icon-pencil7'></i> Edit Information" +
                                        "</a>" +
                                        "<a href='@Url.Action("Delete", "HrDivisionDesignationMap")/" + data + "' class='dropdown-item text-danger'>" +
                                            "<i class='icon-cross'></i> Delete Information" +
                                        "</a>" +
                                    "</div>" +
                                "</div>" +
                            "</div>";

                            return retVal;
                        }
                    }
                ]
            });
        }

        $(document).ready(function () {
            UpdateDataTable();
        });
    </script>
}