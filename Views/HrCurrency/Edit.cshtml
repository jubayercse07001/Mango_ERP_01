@using ERP.Models.HR.Common.HrCountry;
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page header -->
<div class="page-header page-header-light ">


    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index", "Home")" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
                <a href="@Url.Action("Index", "HrCurrency")" class="breadcrumb-item">Currency</a>  <span class="breadcrumb-item active">Edit</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>


    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <!-- Individual column searching (text inputs) -->


    <form action="#" id="my-form">
        <div class="card" id="maindiv">
            <div class="card-header bg-white header-elements-inline">
                <h6 class="card-title">Edit Existing Currency</h6>
                <input type="hidden" name="RowId" value="@ViewBag.HrCurrency.RowId" />
            </div>

            <div class="card-body">

                <div class="form-group row">
                    <label class="col-form-label col-lg-2">
                        <span class="text-danger">*</span>Country Name:
                    </label>
                    <div class="col-lg-2">
                        <select class="custom-select" name="CountryId" id="CountryDDL">
                            <option value="">Select Country</option>
                            @foreach (HrCountryInfo a in (List<HrCountryInfo>)ViewBag.HrCountrys)
                            {
                                <option value="@a.RowId" @(ViewBag.HrCurrency.CountryId == a.RowId ? "selected" : "")>
                                    @a.CountryName
                                </option>
}
                        </select>
                    </div>
                </div>

                <div class="form-group row ">
                    <label class="col-form-label col-lg-2">Currency Name:</label>
                    <div class="col-lg-2">
                        <input type="text" name="CurrencyName" class="form-control" placeholder="Currency Name" value="@ViewBag.HrCurrency.CurrencyName">
                    </div>
                </div>
                <div class="form-group row ">
                    <label class="col-form-label col-lg-2">Currency Code:</label>
                    <div class="col-lg-2">
                        <input type="text" name="CurrencyCode" class="form-control" placeholder="Currency Code" value="@ViewBag.HrCurrency.CurrencyCode">
                    </div>
                </div>
                <div class="form-group row ">
                    <label class="col-form-label col-lg-2">Currency Symbol:</label>
                    <div class="col-lg-2">
                        <input type="text" name="CurrencySymbol" class="form-control" placeholder="Currency Symbol" value="@ViewBag.HrCurrency.CurrencySymbol">
                    </div>
                </div>
                <div class="form-group row ">
                    <label class="col-form-label col-lg-2">Rank:</label>
                    <div class="col-lg-2">
                        <input type="text" name="Rank" class="form-control" placeholder="Rank" value="@ViewBag.HrCurrency.Rank">
                    </div>
                </div>

            </div>
            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage">
                        there
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white" id="successdiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-success">
                        <h2>  Currency has been updated successfully. </h2>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" id="btnSubmit" class="btn bg-blue ml-3">Submit <i class="icon-paperplane ml-2"></i></button>
                            <button type="button" class="btn btn-light"> <a href="@Url.Action("Index", "HrCurrency")">Back to List</a></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </form>

    <!-- /individual column searching (text inputs) -->



</div>
<!-- /content area -->


@section ChildpageJavaScript{
    <script>

        $(document).ready(function () {
        $("#btnSubmit").click(function () {
            $.ajax(
            {
                type: "POST",
                url:  "@Url.Action("Edit", "HrCurrency")",
                data: $("#my-form").serialize(),
                    success: function (data) {

                        if (data.ResponseStatus == -1) {
                            window.location.href =  "@Url.Action("Logout", "Login")";
                        } else if (data.ResponseStatus == -2) {
                            window.location.href =  "@Url.Action("Index", "HrCurrency")";
                        } else if (data.ResponseStatus == 0) {
                            $("#errormessage").html(data.ResponseMessage);
                            $("#successdiv").hide();
                            $("#errordiv").show();
                        }
                        else {
                            $("#errormessage").html("");
                            $("#errordiv").hide();
                            $("#successdiv").show();
                            }

                    }
                });
            });
    });



    </script>
}


