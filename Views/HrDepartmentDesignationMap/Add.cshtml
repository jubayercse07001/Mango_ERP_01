@using ERP.Models.HR.Organization.HrDepartmentDesignationMap

@{
    ViewBag.Title = "Add Department Designation Map";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="@Url.Action("Index","Home")" class="breadcrumb-item">
                    <i class="icon-home2 mr-2"></i> Home
                </a>
                <a href="@Url.Action("Index","HrDepartmentDesignationMap")" class="breadcrumb-item">
                    Department Designation Map
                </a>
                <span class="breadcrumb-item active">Add</span>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <form id="my-form">
        <div class="card" id="maindiv">
            <div class="card-header bg-white">
                <h6 class="card-title">Add Department - Designation Mapping</h6>
            </div>

            <div class="card-body">
                <div class="form-group row">
                    <label class="col-lg-2 col-form-label">
                        <span class="text-danger">*</span> Department
                    </label>
                    <div class="col-lg-6">
                        <select name="DepartmentId" id="DepartmentId" class="form-control" required>
                            <option value="">Select Department</option>
                            @foreach (var item in ViewBag.DepartmentList)
                            {
                                <option value="@item.RowId">
                                    @item.DepartmentName
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-2">
                    <h6>Designations</h6>
                    <button type="button" class="btn btn-sm btn-success" id="btnAddRow">
                        <i class="icon-plus2 mr-1"></i> Add Designation
                    </button>
                </div>

                <input type="hidden" id="DesignationId" name="DesignationId" />

                <table class="table table-bordered" id="tblDesignation">
                    <thead>
                        <tr>
                            <th>Designation</th>
                            <th style="width:100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <select name="DesignationIds" class="form-control designation-ddl">
                                    <option value="">Select Designation</option>
                                    @foreach (var item in ViewBag.DesignationList)
                                    {
                                        <option value="@item.RowId">
                                            @item.DesignationName
                                        </option>
                                    }
                                </select>
                            </td>
                            <td>
                                <button type="button" class="btn btn-danger btnRemove">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="card-footer bg-white" id="errordiv" style="display:none">
                <div class="row">
                    <div class="col-lg-10 ml-lg-auto text-warning" id="errormessage">
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <button type="button" id="btnSubmit" class="btn bg-blue">
                        Submit <i class="icon-paperplane ml-2"></i>
                    </button>
                    <a href="@Url.Action("Index","HrDepartmentDesignationMap")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>
        </div>

        <div class="card" id="successdiv" style="display:none">
            <div class="card-header bg-white">
                <h6 class="card-title">Department Designation Map Added Successfully</h6>
            </div>
            <div class="card-body">
                <h4 class="text-success">
                    <i class="icon-checkmark4 mr-2"></i> Department Designation Mapping has been added successfully.
                </h4>
            </div>
            <div class="card-footer bg-white">
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Add","HrDepartmentDesignationMap")" class="btn btn-light">
                        Add Another
                    </a>
                    <a href="@Url.Action("Index","HrDepartmentDesignationMap")" class="btn btn-light">
                        Back To List
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@section ChildpageJavaScript
{
    <script>
    $(document).ready(function () {

        // ➕ Append a completely new row to the Designation Data Matrix Mapping Workspace
        $("#btnAddRow").click(function () {
            var row = `
            <tr>
                <td>
                    <select name="DesignationIds" class="form-control designation-ddl">
                        <option value="">Select Designation</option>
                        @foreach (var item in ViewBag.DesignationList)
                        {
                            <option value="@item.RowId">@item.DesignationName</option>
                        }
                    </select>
                </td>
                <td>
                    <button type="button" class="btn btn-danger btnRemove">Remove</button>
                </td>
            </tr>`;

            $("#tblDesignation tbody").append(row);
        });

        // ❌ Remove an explicit row out of the mapping data list context safely
        $(document).on("click", ".btnRemove", function () {
            if ($("#tblDesignation tbody tr").length > 1) {
                $(this).closest("tr").remove();
            } else {
                alert("At least one designation input layer matrix row must remain available.");
            }
        });

        // 🚀 Submit handling validation pipeline routine via AJAX
        $("#btnSubmit").click(function () {
            var designationIds = [];

            // Compile selected items inside array parameters layout
            $(".designation-ddl").each(function () {
                var val = $(this).val();
                if (val != "") {
                    designationIds.push(val);
                }
            });

            if ($("#DepartmentId").val() === "") {
                $("#errormessage").html("Please choose a valid Department item before committing.");
                $("#errordiv").show();
                return false;
            }

            if (designationIds.length === 0) {
                $("#errormessage").html("Please choose at least one valid Designation item mapping.");
                $("#errordiv").show();
                return false;
            }

            // Bind aggregated designations as comma-separated values matching string mappings expected by legacy controller configurations
            $("#DesignationId").val(designationIds.join(','));

            $.ajax({
                type: "POST",
                url: '@Url.Action("Add","HrDepartmentDesignationMap")',
                data: $("#my-form").serialize(),
                success: function (data) {
                    if (data.ResponseStatus == -1) {
                        // User session token lifecycle validation break tracking loop logic
                        window.location.href = '@Url.Action("Logout","Login")';
                    }
                    else if (data.ResponseStatus == 0) {
                        // Operational failure context feedback processing loop channel
                        $("#errormessage").html(data.ResponseMessage);
                        $("#errordiv").show();
                    }
                    else {
                        // Processing completely clean. Display success panel layout configuration metrics
                        $("#errordiv").hide();
                        $("#maindiv").hide();
                        $("#successdiv").show();
                    }
                },
                error: function (xhr, status, error) {
                    $("#errormessage").html("An unexpected infrastructure communications network mapping exception was dropped. Details: " + error);
                    $("#errordiv").show();
                }
            });
        });
    });
    </script>
}